//@version=6
indicator("BTC 4H Market Radar — Live Footprint (DESCRIPTIVE ONLY)", overlay = false, max_labels_count = 20)

// ============================================================================
// THIS IS A SEPARATE FILE ON PURPOSE. Read this before adding it to a chart.
//
// LIVE / DESCRIPTIVE ONLY — NOT HISTORICAL EVIDENCE
//
// WHAT "BUY" AND "SELL" MEAN HERE, AND WHAT THEY DO NOT
// request.footprint() splits a bar's volume by CLASSIFYING lower-timeframe
// intrabars. It is not an exchange aggressor feed: nothing in it reports which
// side of each trade removed liquidity. So the two totals are CLASSIFIED buy
// and sell volume, and volume delta is the difference between two classified
// totals. Every user-visible label says "classified" for that reason, and none
// of them uses wording that would imply a live aggressor tape — a
// classification and an aggressor tape are different measurements, and only one
// of them exists here.
//
// TradingView's own documentation states that footprint data REPAINTS BY
// DESIGN: "in real time the chart may use one intrabar source (e.g. 1T) while
// the same bar is later recalculated using a less granular interval (e.g. 1S)".
// A number that is computed one way live and a different way afterwards cannot
// be backtested, cannot appear in the prospective event log, and cannot support
// any claim about what follows. It is a live readout and nothing else.
//
// WHY IT IS NOT INSIDE main.pine
//   1. request.footprint() requires a Premium, Premium+ or Ultimate plan. A
//      script that calls it is unusable to everyone else. The Radar must run
//      for anyone, so the call cannot sit in it — Pine has no way to compile a
//      function call away behind an input toggle.
//   2. PineTS, the offline runtime the Radar's 27-check test suite runs on, has
//      no implementation of request.footprint(). Putting the call in main.pine
//      would take down every offline test and every audit in one move, trading
//      a fully verified core for one unverifiable feature.
//   3. Repainting data has no business sharing a file with a script whose whole
//      point is that its numbers do not change after the fact.
//
// NOTHING HERE IS TESTED OFFLINE. Every line below is MANUAL VALIDATION
// REQUIRED — see TRADINGVIEW-VALIDATION.md, section F.
//
// Add it as a second indicator in its own pane, or do not add it at all. The
// Radar is complete without it.
// ============================================================================

ticksPerRow = input.int(100, "Ticks per footprint row", minval = 1, tooltip = "One tick is syminfo.mintick. Aim for roughly 25 rows per bar: lower values give finer rows and use more drawing objects.")
vaPct       = input.int(70,  "Value Area percentage",   minval = 1, maxval = 99)
imbPct      = input.int(300, "Imbalance percentage",    minval = 100)
showTable   = input.bool(true, "Show readout")

// Only one request.footprint() call is permitted per script, and it counts
// against the 40-request budget (64 on Ultimate).
footprint fp = request.footprint(ticksPerRow, vaPct, imbPct)

// na is the documented return when the bar has no footprint data — which is the
// normal case on older bars and on symbols whose feed does not carry
// tick-by-tick volume. Everything below is guarded on it.
avail = not na(fp)

// Classified totals, not aggressor totals. See the header.
float buyVol  = avail ? fp.buy_volume()  : na
float sellVol = avail ? fp.sell_volume() : na
float delta   = avail ? fp.delta()       : na
float total   = avail ? buyVol + sellVol : na
float deltaPc = avail and total > 0 ? delta / total : na

float pocUp = na
float pocDn = na
float vahUp = na
float valDn = na
if avail
    volume_row poc = fp.poc()
    volume_row vah = fp.vah()
    volume_row val = fp.val()
    if not na(poc)
        pocUp := poc.up_price()
        pocDn := poc.down_price()
    if not na(vah)
        vahUp := vah.up_price()
    if not na(val)
        valDn := val.down_price()

plot(delta,  "Volume delta (classified)", color = delta > 0 ? color.new(color.teal, 20) : color.new(color.red, 20), style = plot.style_columns)
plot(buyVol, "Classified buy volume",   color = color.new(color.teal, 70), display = display.data_window)
plot(sellVol, "Classified sell volume", color = color.new(color.red, 70), display = display.data_window)
hline(0, "zero", color = color.new(color.gray, 60))

f2(x) => na(x) ? "n/a" : str.tostring(x, "#.##")
pc(x) => na(x) ? "n/a" : (x >= 0 ? "+" : "") + str.tostring(x * 100, "#.#") + "%"

// Declared at top level: Pine does not allow a function declaration inside an
// if block.
row(t, i, a, b, bg) =>
    table.cell(t, 0, i, a, text_color = color.new(color.white, 20), text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, i, b, text_color = color.white, bgcolor = bg, text_size = size.tiny, text_halign = text.align_right)

var table t = na
if showTable and barstate.islast
    table.delete(t)
    t := table.new(position.bottom_left, 2, 8, border_width = 1, border_color = color.new(color.gray, 70))
    row(t, 0, "LIVE FOOTPRINT", avail ? "FOOTPRINT AVAILABLE" : "NO FOOTPRINT DATA", avail ? color.new(color.blue, 30) : color.new(color.gray, 30))
    row(t, 1, "Classified buy volume",  f2(buyVol),  color.new(color.teal, 60))
    row(t, 2, "Classified sell volume", f2(sellVol), color.new(color.red, 60))
    row(t, 3, "Volume delta",  f2(delta) + "  " + pc(deltaPc), na(delta) ? color.new(color.gray, 50) : delta > 0 ? color.new(color.teal, 40) : color.new(color.red, 40))
    row(t, 4, "POC",         na(pocDn) ? "n/a" : f2(pocDn) + " – " + f2(pocUp), color.new(color.orange, 45))
    row(t, 5, "VAH",         f2(vahUp), color.new(color.gray, 55))
    row(t, 6, "VAL",         f2(valDn), color.new(color.gray, 55))
    row(t, 7, "EVIDENCE",    "LIVE / DESCRIPTIVE ONLY — CLASSIFIED, NOT AGGRESSOR — REPAINTS BY DESIGN", color.new(color.red, 45))

// No alerts. A repainting series must not be able to wake anyone up, and it
// must never enter the prospective event log — see audit/event-log.mjs, whose
// cohort identity deliberately covers main.pine only.
