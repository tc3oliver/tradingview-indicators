//@version=6
indicator("BTC 4H Market Radar", overlay = true, max_bars_back = 2500)

// THRESHOLD-VERSION: v3.2
// Bump this whenever a threshold, window or state DEFINITION changes in a way
// that alters what an event means. It is one of the five fields that identify a
// prospective cohort (audit/cohort.mjs); events recorded under a different
// value can never be pooled with these.

// ============================================================================
// WHAT THIS IS
//
// A monitor, not a forecaster. It watches open interest, funding, perpetual
// premium, spot-vs-perp participation, liquidations, ETF flow and SOPR,
// normalises each against its own recent history, and — in ten to fourteen
// rows of plain English — tells you:
//
//   1. what state the market is in         (TREND)
//   2. whether volatility is higher than usual (RISK)
//   3. the one thing worth looking at      (MAIN THING TO WATCH)
//   4. whether the data can be trusted     (DATA)
//
// It does not tell you what will happen next, because it cannot.
//
// THREE DISPLAY MODES, AND THE MODE IS PRESENTATION ONLY.
//   Decision  the default and the product. Nothing normal is printed. No
//             z-score, no percentile, no sample count, no research vocabulary.
//   Detailed  every measure with its raw value, empirical rank and σ, every
//             feed's freshness, the full event list.
//   Debug     Detailed plus sample counts, status integers and unrounded σ.
// Every measured output is bit-identical in all three, asserted bar by bar in
// tests.mjs check 28, and identical to the pre-rewrite v3.2 build in check 27.
//
// ZERO CONFIGURATION FOR THE CORE. The four feeds every reading depends on —
// reference perpetual, spot, base-unit open interest, confirmed daily 200MA —
// are default symbols. All four external adapters are off by default and none
// of them blocks anything.
//
// TWO INDEPENDENT AXES, NEVER MIXED  (the v3 correctness rule)
//   RAW VALUE decides WHAT HAPPENED.   oiChg24h < 0 is a REDUCTION. Always.
//   PERCENTILE / Z decides HOW UNUSUAL it is.  NORMAL / UNUSUAL / EXTREME.
// A label is always <intensity> <direction>, and the direction word is derived
// from the sign of the raw measurement — never from the sign of a z-score. In
// v2 they were fused, so a −1.0% open-interest change could be printed as
// "EXPANDING" whenever the recent mean was more negative still. That was a lie
// about the data and it is the reason this version exists.
//
// Percentile is shown first because crypto distributions are not normal. σ is
// kept beside it as secondary text and as the driver of the hysteresis ladder,
// which is what the stability audit measured.
//
// ONE PRICE SOURCE. Every price-derived feature — return, ATR, realised
// volatility, 24H change, trend distance, the daily 200MA, 12-week momentum and
// market mechanics — is computed from the BTC reference symbol below. The
// chart's own `close` is used in exactly one place: detecting an unwired
// input.source() adapter. Put this on any chart you like; the readings do not
// change.
//
// EXACTLY 4H. Every window here is defined in 4H bars — 24H is six bars, RVOL
// compares the same UTC slot on previous days, events are 4H events. On any
// other timeframe those definitions are silently wrong, so the script refuses
// to run instead.
//
// WHY THERE IS NO ACTION LAYER
// v1 shipped one. It was audited against matched price-environment controls on
// 13,164 bars of 4H BTC and all three candidate Actions failed:
//   - DO NOT CHASE on a leveraged rally: 13 episodes in six years, development
//     and validation opposite in sign on every outcome.
//   - REDUCE EXPOSURE on risk-off: matched controls showed LESS forward
//     drawdown, not more (+0.53 ATR at 3D, +0.87 at 7D). The state fired after
//     the fall, not before.
//   - Spot-led rallies are higher quality: a real, direction-consistent effect
//     that pointed the OPPOSITE way and shrank fourfold once the extreme 5% of
//     episodes were trimmed.
// Earlier work also falsified open-interest direction, top-trader positioning,
// market structure as a gate, and derivatives as a risk flag. See
// audit/AUDIT.md and ../btc-4h-regime-engine/RESEARCH-LOG.md.
//
// WHY THERE IS NO POSITION SIZE EITHER
// A mechanical volatility-scaling risk budget —
// clamp(median(rvol30, 2190) / rvol30, 0.25, 1.0) — was specified, implemented
// here, and put through a pre-registered retrospective risk-control validation
// with seven adoption gates fixed before the first run. Six passed. G1 failed:
// the dispersion of rolling 24H realised volatility improved 3.2% against a
// required 10%. The pre-registration said all seven, so the module was removed
// rather than re-tuned. audit/risk-budget-validation.mjs keeps the record and
// re-runs standalone.
//
// HYSTERESIS is used for readability only. It stops a level flickering across a
// threshold; it is not claimed to improve any decision.
//
// UNITS GUARD. USD-notional open interest is base-unit OI times price, so it
// falls whenever price falls. In testing it labelled 91% of pullbacks "healthy
// deleveraging". A feed that looks like notional is rejected outright.
// ============================================================================

// ------------------------------------------------------- 0. timeframe lock --
// Not a preference. 24H = 6 bars, the same-slot RVOL comparison, the OI 24H
// window and every event definition below are hard-coded to a 4H bar. On a 1H
// chart "24H" would silently mean four hours.
tfOK = timeframe.in_seconds(timeframe.period) == 14400
if not tfOK
    runtime.error("BTC 4H Market Radar requires an exact 4-hour (240 minute) chart. Every window in this script — 24H = 6 bars, same-slot RVOL, OI 24H, event windows — is defined in 4H bars and is wrong on any other timeframe.")

// Fixed by the lock above. Written as a named constant so the 4H assumption is
// visible at every use site rather than appearing as a bare 6.
BARS_PER_DAY = 6

// ------------------------------------------------------------- 1. inputs ----
G_SYM = "Symbols"
refSym  = input.symbol("BINANCE:BTCUSDT.P",    "BTC reference (perpetual)", group = G_SYM, tooltip = "EVERY price-derived feature comes from this symbol: return, ATR, realised volatility, 24H change, trend distance, daily 200MA, 12W momentum, perp RVOL, and the numerator of the perp premium. The chart's own symbol is never used for a reading.")
spotSym = input.symbol("BINANCE:BTCUSDT",      "Spot",                      group = G_SYM, tooltip = "Denominator of the perp premium, and the spot side of the participation ratio.")
oiSym   = input.symbol("BINANCE:BTCUSDT.P_OI", "Open interest",             group = G_SYM, tooltip = "Must be BASE-UNIT (BTC) open interest. A USD-notional feed is rejected at runtime: it moves with price and cannot measure positioning.")
soprSym = input.symbol("GLASSNODE:BTC_SOPR",   "SOPR",                      group = G_SYM)

G_EXT = "External data — point at another indicator's plot"
// ADAPTER CONTRACT. An input.source() carries a number and nothing else — no
// unit, no timestamp, no statement of what one observation represents. Every
// assumption the script would otherwise have to guess is an explicit input, and
// where the assumption cannot be checked the reading is withheld rather than
// computed from a guess.
useFunding = input.bool(false, "Enable funding adapter",        group = G_EXT)
extFunding = input.source(close, "  Aggregated funding rate",   group = G_EXT, tooltip = "Reads DATA UNAVAILABLE until enabled AND wired to a plot other than the chart's close.")
fundUnit   = input.string("Decimal (0.0001 = 0.01%)", "  Funding unit", options = ["Decimal (0.0001 = 0.01%)", "Percent (0.01 = 0.01%)", "Basis points (1 = 0.01%)"], group = G_EXT, tooltip = "The z-score and percentile do not care about scale, but the printed rate does. Get this wrong and the FUNDING row is off by 100x while still looking plausible.")
useEtf     = input.bool(false, "Enable ETF flow adapter",       group = G_EXT)
extEtf     = input.source(close, "  US spot BTC ETF net flow",  group = G_EXT)
etfShape   = input.string("Daily value, repeated within the day", "  ETF source shape", options = ["Daily value, na except on a new observation", "Daily value, repeated within the day", "Per-bar increment"], group = G_EXT, tooltip = "ETF flow is published DAILY, on US trading days only. What the script can compute — and what it is allowed to call the result — depends entirely on which of these your plot is.\n\nna except on a new observation: the ONLY shape that supports a true 'last five observations' total. Your source must plot the figure on ONE bar per observation and na on every other bar — including every bar of a weekend or a market holiday. Row reads ETF LAST 5 OBS.\n\nRepeated within the day: a daily figure carried across all six 4H bars. The total then samples one bar per CALENDAR day, so a weekend or a holiday re-counts the previous session. Row reads ETF 5 CAL-DAY and it is not a five-trading-day flow.\n\nPer-bar increment: each 4H bar carries its own separate flow. Row reads ETF 30-BAR SUM.")
useLiqL    = input.bool(false, "Enable long-liquidation adapter",  group = G_EXT)
extLiqL    = input.source(close, "  Long liquidations",         group = G_EXT, tooltip = "Notional or contracts — for the LONG LIQ row itself either is fine, because only its own percentile is read.")
useLiqS    = input.bool(false, "Enable short-liquidation adapter", group = G_EXT)
extLiqS    = input.source(close, "  Short liquidations",        group = G_EXT)
liqPaired  = input.bool(false, "  Long and short liquidations share one source and unit", group = G_EXT, tooltip = "LIQ BALANCE is (long - short) / (long + short). That subtraction is only meaningful if both inputs are the same quantity, in the same unit, from the same provider. Landing in [-1, +1] proves nothing — two unrelated scales also land in [-1, +1]. Leave this OFF unless you know both plots match; the balance then reads DATA INCOMPARABLE instead of inventing a number.")

G_CFG = "Normalisation windows"
zWin      = input.int(180,  "Percentile / z lookback (bars)",  minval = 30, maxval = 1000, group = G_CFG, tooltip = "180 bars = 30 days at 4H. Used for BOTH the empirical percentile and the z-score, so the two always describe the same window.")
volPctWin = input.int(2190, "Volatility percentile lookback",  minval = 200, maxval = 2400, group = G_CFG)
rvolDays  = input.int(28,   "RVOL comparison window (days)",   minval = 7, maxval = 60, group = G_CFG, tooltip = "Volume is compared with the SAME time-of-day slot on previous days. A flat average would call every Asian-hours bar quiet forever.")
cvdTF     = input.timeframe("5", "Flow proxy lower timeframe", group = G_CFG)

// Schmitt-trigger thresholds, in σ of the same window as the percentile.
// Entering costs more than staying. Display stability only — no claim of added
// information. These set the UNUSUAL (enter/exit) and EXTREME (X) boundaries.
G_HYS = "Hysteresis (display stability only)"
oiEnter   = input.float(1.0,  "OI unusual (σ)",         minval = 0.2, step = 0.05, group = G_HYS)
oiExit    = input.float(0.6,  "OI unusual exit (σ)",    minval = 0.1, step = 0.05, group = G_HYS)
oiXEnter  = input.float(2.0,  "OI extreme (σ)",         minval = 0.5, step = 0.05, group = G_HYS)
oiXExit   = input.float(1.25, "OI extreme exit (σ)",    minval = 0.2, step = 0.05, group = G_HYS)
fundEnter = input.float(1.5,  "Funding elevated (σ)",   minval = 0.2, step = 0.05, group = G_HYS)
fundExit  = input.float(1.0,  "Funding elevated exit (σ)", minval = 0.1, step = 0.05, group = G_HYS)
fundXEnter= input.float(2.5,  "Funding extreme (σ)",    minval = 0.5, step = 0.05, group = G_HYS)
fundXExit = input.float(1.75, "Funding extreme exit (σ)", minval = 0.2, step = 0.05, group = G_HYS)
premEnter = input.float(2.0,  "Premium unusual (σ)",    minval = 0.2, step = 0.05, group = G_HYS)
premXEnter= input.float(2.75, "Premium extreme (σ)",    minval = 0.5, step = 0.05, group = G_HYS)
partEnter = input.float(1.0,  "Participation surge (σ)", minval = 0.2, step = 0.05, group = G_HYS)
rvolEnter = input.float(1.5,  "RVOL unusual (σ)",       minval = 0.2, step = 0.05, group = G_HYS)
etfEnter  = input.float(1.0,  "ETF unusual (σ)",        minval = 0.2, step = 0.05, group = G_HYS)
etfExit   = input.float(0.6,  "ETF unusual exit (σ)",   minval = 0.1, step = 0.05, group = G_HYS)
etfXEnter = input.float(2.0,  "ETF extreme (σ)",        minval = 0.5, step = 0.05, group = G_HYS)
etfXExit  = input.float(1.25, "ETF extreme exit (σ)",   minval = 0.2, step = 0.05, group = G_HYS)
liqEnter  = input.float(1.5,  "Liquidation spike (σ)",  minval = 0.2, step = 0.05, group = G_HYS)
liqExit   = input.float(1.0,  "Liquidation spike exit (σ)", minval = 0.1, step = 0.05, group = G_HYS)
liqXEnter = input.float(2.5,  "Liquidation extreme (σ)", minval = 0.5, step = 0.05, group = G_HYS)
liqXExit  = input.float(1.75, "Liquidation extreme exit (σ)", minval = 0.2, step = 0.05, group = G_HYS)
trEnter   = input.float(0.5,  "Trend enter (ATR from 200D)", minval = 0.1, step = 0.05, group = G_HYS)
trExit    = input.float(0.2,  "Trend exit (ATR from 200D)",  minval = 0.05, step = 0.05, group = G_HYS)
soprEnter = input.float(0.02, "SOPR enter (dev from 1)", minval = 0.001, step = 0.001, group = G_HYS)
soprExit  = input.float(0.01, "SOPR exit (dev from 1)",  minval = 0.001, step = 0.001, group = G_HYS)

G_UI = "Display"
showTable = input.bool(true, "Dashboard", group = G_UI)
// DISPLAY MODE IS PRESENTATION AND NOTHING ELSE. It selects which rows are
// drawn. It does not reach a measurement, a threshold, a state definition, an
// event, an alert or the prospective cohort — every t_* output is bit-identical
// in all three modes, which tests.mjs asserts bar by bar.
dispMode  = input.string("Decision", "Detail level", options = ["Decision", "Detailed", "Debug"], group = G_UI, tooltip = "Decision: ten to fourteen rows answering five questions — what state is the market in, is risk higher than usual, how much size does that justify, what is the one thing worth looking at, and is the data healthy. No z-scores, no percentiles, no normal readings.\n\nDetailed: every measure with its raw value, percentile and σ, every feed's freshness, and the full event list.\n\nDebug: Detailed plus sample counts, exact σ, status codes and internal state codes.")
maxAnom   = input.int(5, "Max anomalies listed (Detailed)", minval = 1, maxval = 9, group = G_UI, tooltip = "Decision always shows exactly one — the highest-priority anomaly.")
maxEvents = input.int(5, "Recent events listed (Detailed)", minval = 3, maxval = 5, group = G_UI)
tblPos    = input.string("Top right", "Position", options = ["Top right", "Middle right", "Bottom right", "Top left", "Bottom left"], group = G_UI)
// The v3.2 chart label was a paragraph pinned to the last bar's high — directly
// on top of a top-right dashboard. Every warning it carried is now a row in the
// panel itself, so the label is off by default and one short line when on.
warnLabel = input.bool(false, "Chart warning label (short)", group = G_UI, tooltip = "Off by default. Everything it would say already appears under SETUP REQUIRED / DATA in the dashboard; the label existed only because v2 had nowhere else to put it.")

modeDecision = dispMode == "Decision"
modeDebug    = dispMode == "Debug"


// ------------------------------------------------------ 2. data requests ----
// `int(time)` rides along in every tuple. request.security carries the last
// available value forward when a symbol has no bar at the current chart bar, so
// comparing the returned bar time with the chart's is the only honest way to
// tell "up to date" from "silently repeating a stale reading".
//
// The int() is a no-op cast on TradingView — `time` is already series int. It
// is there because PineTS drops a bare `time` when it appears inside a tuple
// captured by request.security, which would make every freshness check read
// UNAVAILABLE offline and quietly hollow out the test suite. Writing int(time)
// captures correctly in both runtimes.
[rO, rH, rL, rC, rV, rT] = request.security(refSym, timeframe.period, [open, high, low, close, volume, int(time)], ignore_invalid_symbol = true)
[spotC, spotV, spotT]    = request.security(spotSym, timeframe.period, [close, volume, int(time)], ignore_invalid_symbol = true)

// TradingView declines to specify the denomination of a non-aggregated OI
// symbol — "may be presented in base currency, quote currency, or contracts,
// depending on the exchange". So ask the feed. syminfo.* evaluates in the
// REQUESTED context; "NONE" means the values are not currency amounts, which is
// what a base-unit or contract feed looks like.
[oiRaw, oiCur, oiT] = request.security(oiSym, timeframe.period, [close, syminfo.currency, int(time)], ignore_invalid_symbol = true)

// Documented non-repainting idiom: request the PREVIOUS completed daily value
// with lookahead on. Fixed for the whole following day, can never change after
// the fact. The [1] offset and lookahead_on are interdependent.
[dSma200, dMom12w, dT] = request.security(refSym, "1D", [ta.sma(close, 200)[1], close[1] / close[85] - 1, int(time[1])], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[soprD, soprT] = request.security(soprSym, "1D", [close[1], int(time[1])], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

// ESTIMATED flow. Lower-timeframe bars are classified by their own direction —
// not aggressor data. ignore_invalid_timeframe must be true: it defaults to
// false, and a user-editable timeframe set above the chart's would raise a
// runtime error and halt the script.
[perpUp, perpDn] = request.security_lower_tf(refSym, cvdTF, [close > open ? volume : 0.0, close < open ? volume : 0.0], ignore_invalid_timeframe = true)
[spotUp, spotDn] = request.security_lower_tf(spotSym, cvdTF, [close > open ? volume : 0.0, close < open ? volume : 0.0], ignore_invalid_timeframe = true)

// Two distinct failures returning different things: no intrabar data for a bar
// gives an EMPTY ARRAY, an invalid timeframe gives na. array.size() on an na
// array throws, so both go through this.
arrLen(a) =>
    na(a) ? 0 : array.size(a)

arrSum(a) =>
    float s = 0.0
    if arrLen(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            s += na(v) ? 0.0 : v
    s

flowOK    = arrLen(perpUp) > 0 and arrLen(spotUp) > 0
perpDelta = flowOK ? arrSum(perpUp) - arrSum(perpDn) : na
spotDelta = flowOK ? arrSum(spotUp) - arrSum(spotDn) : na

// ------------------------------------------- 3. availability / freshness ----
// STATUS CODES, one vocabulary for every feed:
//   0 UNAVAILABLE   nothing there, or the adapter is switched off
//   1 MISCONFIGURED enabled but still pointed at the chart's own close
//   2 STALE         present but too old to describe the current bar
//   3 OLD           one period behind — normal for a daily feed, tolerable
//   4 FRESH         current
// Anything below 3 is treated as no data: no reading, no anomaly, no event.
//
// FRESHNESS POLICY (bars are 4H; also documented in README.md)
//   reference / spot / OI   0 bars behind = FRESH, 1 = OLD, >1 = STALE.
//                           These are exchange feeds on the chart's own
//                           timeframe; a second bar of lag means an outage.
//   daily 200MA             1 day behind BY CONSTRUCTION (previous completed
//                           daily bar). <=2d FRESH, <=3d OLD, >3d STALE.
//   SOPR                    same, plus Glassnode's own publication lag.
//
// The four input.source() adapters are a DIFFERENT KIND OF MEASUREMENT and get
// a different vocabulary. They carry no upstream timestamp, so the only thing
// observable is whether the number changed. A live feed that legitimately
// repeats a value — funding pinned at the same rate, zero ETF flow on a holiday,
// a quiet hour with no liquidations — is indistinguishable from a dead one. So
// they report UPDATE ACTIVITY, not freshness, and the words say so:
//   ACTIVE / UNCHANGED 1 BAR / LIKELY STALE / MISCONFIGURED / UNAVAILABLE
// Readings are still suppressed at LIKELY STALE, because acting on a possibly
// dead feed is worse than losing a possibly live one. That is a conservative
// choice, not a proof that the feed is dead.
//   funding adapter         settles every 8h = 2 bars. Unchanged >6 bars (24h)
//                           is LIKELY STALE.
//   ETF adapter             daily and business-day only, so a 3-day weekend is
//                           normal. Unchanged >30 bars (5 days) is LIKELY STALE.
//   liquidation adapters    should move most bars. Unchanged >6 bars is LIKELY
//                           STALE.
BARS_STALE_FUNDING = 6
BARS_STALE_ETF     = 30
BARS_STALE_LIQ     = 6

barsBehind(feedT) =>
    na(feedT) ? na : math.floor((time - feedT) / 14400000.0)

daysBehind(feedT) =>
    na(feedT) ? na : math.floor((time - feedT) / 86400000.0)

statOf4H(present, behind) =>
    not present or na(behind) ? 0 : behind <= 0 ? 4 : behind <= 1 ? 3 : 2

statOfDaily(present, behind) =>
    not present or na(behind) ? 0 : behind <= 2 ? 4 : behind <= 3 ? 3 : 2

refStat  = statOf4H(not na(rC) and rC > 0 and not na(rV), barsBehind(rT))
spotStat = statOf4H(not na(spotC) and spotC > 0 and not na(spotV), barsBehind(spotT))
dailyStat = statOfDaily(not na(dSma200), daysBehind(dT))
soprStat  = statOfDaily(not na(soprD), daysBehind(soprT))

oiCurSaysNotional = not na(oiCur) and (oiCur == "USD" or oiCur == "USDT" or oiCur == "USDC")
// The zero test is not padding: the Binance OI history has 12 bars at exactly
// zero across 2022-2025, and oi/oi[1]-1 would read -100% and poison the window.
oiLooksNotional = oiCurSaysNotional or (not na(oiRaw) and oiRaw > 5e6)
oiPresent = not na(oiRaw) and oiRaw > 0 and not oiLooksNotional
oiStat    = statOf4H(oiPresent, barsBehind(oiT))

// A VALID OBSERVATION is stricter than "the feed is usable". It means this bar
// carries its own open-interest reading: present, positive, base-unit, and
// timestamped to this bar rather than a value request.security carried forward.
// Only two valid observations may be subtracted from each other.
oiObs = oiPresent and barsBehind(oiT) == 0

refOK   = refStat >= 3
spotOK  = spotStat >= 3
dailyOK = dailyStat >= 3
soprOK  = soprStat >= 3
oiOK    = oiStat >= 3
oi      = oiOK ? oiRaw : na

// An unwired input.source() returns exactly its default — no na, no sentinel —
// so "user picked close" is indistinguishable from "user picked nothing". The
// toggle is the contract; the comparison catches enabling without wiring.
//
// This is the ONLY place the chart's own `close` is read. It never reaches a
// Radar measurement: it is a wiring test, not a price.
//
// Both helpers below hold per-call-site state, so each is called exactly once
// and unconditionally. A skipped call would desynchronise its counter forever.
staleBars(src) =>
    var int n = 999
    if not na(src) and not na(src[1])
        n := src != src[1] ? 0 : n + 1
    n

// Bars since the source last carried a value at all. The na-gated ETF shape is
// SUPPOSED to be na on the five bars of a day that carry no new figure, so for
// that shape "na" means "no observation this bar", not "no feed" — and its
// update activity has to be measured on arrivals rather than on changes.
barsSinceValue(src) =>
    var int n = 999
    n := na(src) ? n + 1 : 0
    n

onChartClose(src) =>
    h = ta.highest(math.abs(src - close), 50)
    // na for the first 50 bars: not enough history to tell a wired plot from
    // the chart's own close. Default to "not wired" — an adapter that has not
    // yet proved itself must not produce readings.
    na(h) or h <= 0

// Canonical funding: a decimal fraction per settlement, whatever the plot uses.
// Scale never reaches the z-score or the percentile — both are scale-free — but
// it is the whole of the printed rate.
fundScale = fundUnit == "Percent (0.01 = 0.01%)" ? 0.01 : fundUnit == "Basis points (1 = 0.01%)" ? 0.0001 : 1.0
fundCanon = extFunding * fundScale
etfNaGated   = etfShape == "Daily value, na except on a new observation"
etfDailyMode = etfShape == "Daily value, repeated within the day"

// staleBars() and onChartClose() read the RAW input, before canonicalisation:
// the wiring test compares against the chart's close, and a positive rescale
// cannot change whether a value moved.
fdHeld = staleBars(extFunding)
etHeld = staleBars(extEtf)
lLHeld = staleBars(extLiqL)
lSHeld = staleBars(extLiqS)
fdWired = not onChartClose(extFunding)
etWired = not onChartClose(extEtf)
lLWired = not onChartClose(extLiqL)
lSWired = not onChartClose(extLiqS)

adapterStat(enabled, src, wired, held, staleAfter) =>
    not enabled ? 0 : na(src) ? 0 : not wired ? 1 : held > staleAfter ? 2 : held >= 1 ? 3 : 4

fdStat = adapterStat(useFunding, extFunding, fdWired, fdHeld, BARS_STALE_FUNDING)
// An na-gated source proves it is wired the instant it produces an na: the
// chart's own close is never na, so the wiring test that works for the other
// three adapters is neither needed nor usable here.
etfObsAge = barsSinceValue(extEtf)
etfNaSeen = ta.highest(na(extEtf) ? 1.0 : 0.0, 200) > 0
etStat = not useEtf ? 0 : etfNaGated ? (not (etfNaSeen or etWired) ? 1 : etfObsAge > BARS_STALE_ETF ? 2 : etfObsAge >= 1 ? 3 : 4) : adapterStat(useEtf, extEtf, etWired, etHeld, BARS_STALE_ETF)
lLStat = adapterStat(useLiqL,    extLiqL,    lLWired, lLHeld, BARS_STALE_LIQ)
lSStat = adapterStat(useLiqS,    extLiqS,    lSWired, lSHeld, BARS_STALE_LIQ)

fundOK = fdStat >= 3
etfOK  = etStat >= 3
liqLOK = lLStat >= 3
liqSOK = lSStat >= 3
liqOK  = liqLOK and liqSOK

// ------------------------------------------------------------ 4. helpers ----
// Every ta.* call in this file runs UNCONDITIONALLY and is masked afterwards.
// Calling a stateful builtin inside a ternary branch leaves its internal window
// with holes on the bars the branch was not taken, which silently corrupts
// every later value. v2 did exactly that on nine series. The one exception is
// validNorm() below, which is stateless and calls no ta.* function at all.

// How far from the middle, regardless of side. Used only to RANK anomalies.
extOf(p) =>
    na(p) ? na : math.max(p, 100.0 - p)

slotRvol(src, days) =>
    float acc = 0.0
    int cnt = 0
    for k = 1 to days
        v = src[k * BARS_PER_DAY]
        if not na(v) and v > 0
            acc += v
            cnt += 1
    cnt >= 5 and acc > 0 ? src / (acc / cnt) : na

f2(x)   => na(x) ? "n/a" : str.tostring(x, "#.##")
sgn2(x) => na(x) ? "n/a" : (x >= 0 ? "+" : "") + str.tostring(x, "#.##")
pctS(x) => na(x) ? "n/a" : (x >= 0 ? "+" : "") + str.tostring(x * 100, "#.##") + "%"
pRank(x) => na(x) ? "—" : str.tostring(x, "#.#") + "p"
// Funding and the perp premium live in the fourth decimal of a percent. Two
// decimals would print every one of them as 0.00%.
pct4(x) => na(x) ? "n/a" : (x >= 0 ? "+" : "") + str.tostring(x * 100, "#.####") + "%"
// Liquidation and ETF notionals arrive in whatever unit the user's plot uses,
// often nine figures. Shown compactly; the percentile beside it is what matters.
big(x) =>
    a = na(x) ? 0.0 : math.abs(x)
    na(x) ? "n/a" : a >= 1e9 ? str.tostring(x / 1e9, "#.##") + "B" : a >= 1e6 ? str.tostring(x / 1e6, "#.##") + "M" : a >= 1e3 ? str.tostring(x / 1e3, "#.##") + "K" : str.tostring(x, "#.##")

// MISSING-VALUE POLICY for everything that feeds a rolling window.
//
// Three attempts, and the first two were both wrong:
//
//   v3.0  nz()            substituted 0. On a CHANGE series 0 means "no
//                         change", a reading the market never produced. Worse,
//                         a zero open-interest tick produced a genuine -100%
//                         change, and one -100% in a 180-bar window inflated
//                         the rolling standard deviation 4.5x — which silently
//                         suppressed 93% of the OI anomalies that should have
//                         fired over the next 30 days.
//   v3.1  carry-forward   repeated the last observed value. That invents no NEW
//                         number, but it is not neutral either: it WEIGHTS the
//                         previous observation once per missing bar.
//                         [+2%, na, na, -1%] became [+2%, +2%, +2%, -1%], and
//                         +2% then counted three times in the mean, the
//                         standard deviation and the rank.
//   v3.2  skip            a missing bar contributes NOTHING. It is not zero, it
//                         is not a repeat, and it does not occupy a slot.
//
// Why this is not left to ta.sma()/ta.stdev(): the Pine documentation says
// "some built-in functions, such as ta.sma(), ignore the bars with na values" —
// note "some", and note that no equivalent statement exists for ta.stdev().
// Pairing a function that skips na with one that does not would compute the
// mean and the deviation over two DIFFERENT sample sets and return a z-score
// that is subtly wrong rather than na. That is a silent failure, and this whole
// revision exists because of one of those. So the statistics are computed here,
// explicitly, in one pass, and the sample set is provably shared.
//
// Welford's method: numerically stable in a single pass, so no catastrophic
// cancellation on series whose values are small relative to their mean.
//
// Returns [z, percentile, n]. na until minN valid samples exist in the window.
// Holds no state and calls no ta.* function, so — unlike almost everything else
// in this file — it is safe to call conditionally.
// `cur` and the SAMPLE SET are separate arguments because they are separate
// questions. The ETF total is well defined on every bar, but a new SAMPLE only
// arrives when the source publishes one; ranking today's total against the
// observation set is right, and adding today's bar to that set again would not
// be. Every other measure passes the same series twice, deliberately: a
// one-line wrapper doing that for them looked tidier and was quietly broken —
// history indexing on a series parameter does not survive a nested user
// function call, so src[i] silently collapsed to src[0], every sample in the
// window became identical, sd went to zero and every z-score read 0.00. Call it
// directly.
validNorm(cur, src, len, minN) =>
    float m  = 0.0
    float m2 = 0.0
    int   n  = 0
    int   le = 0
    for i = 0 to len - 1
        v = src[i]
        if not na(v)
            n += 1
            d = v - m
            m += d / n
            m2 += d * (v - m)
            // Rank against the OTHER valid samples in the same window: a value
            // cannot be more or less than itself. Window and validity rule are
            // identical to the ones the mean and sd use.
            if i > 0 and not na(cur) and v <= cur
                le += 1
    float z = na
    float p = na
    if n >= minN and not na(cur) and n > 1
        sd = math.sqrt(m2 / n)
        z := sd > 0 ? (cur - m) / sd : 0.0
        p := 100.0 * le / (n - 1)
    [z, p, n]

// Sum of the last k VALID observations, looking back at most maxBack bars.
// na until k of them exist. Used for the ETF total, where "the last five
// observations" and "the last five calendar days" are different things.
sumLastValid(src, k, maxBack) =>
    float s = 0.0
    int got = 0
    for i = 0 to maxBack - 1
        if got < k and not na(src[i])
            s += src[i]
            got += 1
    got >= k ? s : na

// The direction axis. Nothing else is allowed to decide a direction word.
dirOf(x) =>
    na(x) ? 0 : x > 0 ? 1 : x < 0 ? -1 : 0

// Two-level magnitude ladder with hysteresis, driven by |z| ONLY. The result is
// an intensity, 0/1/2. It carries no direction — that comes from the raw value.
// A function-local `var` gives every call site independent state, so one
// definition serves all measures, but it must be called unconditionally.
mag(z, e1, x1, e2, x2) =>
    var int lvl = 0
    var int lastConf = 0
    prev = lastConf
    if na(z)
        // No input, no state. A feed that goes stale must not leave its last
        // reading standing as a live anomaly — that is the failure this branch
        // exists to prevent.
        lvl := 0
    else
        a = math.abs(z)
        if lvl == 0
            lvl := a >= e2 ? 2 : a >= e1 ? 1 : 0
        else if a < x1
            lvl := 0
        else if lvl == 2 and a < x2
            lvl := 1
        else if lvl == 1 and a >= e2
            lvl := 2
    if barstate.isconfirmed
        lastConf := lvl
    [lvl, prev]

// Signed three-level Schmitt for measures whose raw value IS the deviation, so
// the threshold and the direction are the same quantity: trend distance in ATR
// and SOPR's deviation from 1. Sign of the state equals the sign of the raw by
// construction — asserted in the test suite rather than assumed.
sch(x, enter, exit) =>
    var int st = 0
    var int lastConf = 0
    prev = lastConf
    if na(x)
        st := 0
    else if st == 0
        st := x >= enter ? 1 : x <= -enter ? -1 : 0
    else if st == 1 and x < exit
        st := 0
    else if st == -1 and x > -exit
        st := 0
    if barstate.isconfirmed
        lastConf := st
    [st, prev]

// Instantaneous, unsmoothed, no state. See the stability audit: for these
// measures nothing made the label readable without destroying the extremes the
// measure exists to report.
imp(z, e1, e2) =>
    na(z) ? 0 : math.abs(z) >= e2 ? 2 : math.abs(z) >= e1 ? 1 : 0

// ----------------------------------------------------------- 5. features ----
// All of these come from the REFERENCE series, never from the chart.
// ta.atr() would read the chart's high/low/close, so true range is rebuilt on
// the reference bars. This is ta.atr's own definition, applied to rH/rL/rC.
refTR  = na(rC[1]) ? rH - rL : math.max(rH - rL, math.max(math.abs(rH - rC[1]), math.abs(rL - rC[1])))
atr14  = ta.rma(refTR, 14)
atrPct = refOK and rC > 0 ? atr14 / rC : na

logRetRaw = not na(rC) and not na(rC[1]) and rC > 0 and rC[1] > 0 ? math.log(rC / rC[1]) : 0.0
rvol30    = ta.stdev(logRetRaw, 30) * math.sqrt(365.0 * BARS_PER_DAY)
volPctLen = volPctWin > 2400 ? 2400 : volPctWin
volPctRaw = ta.percentrank(rvol30, volPctLen)
volPct    = refOK ? volPctRaw : na

// Trend measured as distance from the confirmed daily 200MA in ATR units, so
// the hysteresis threshold means the same thing in 2020 and 2026.
trendDist = dailyOK and refOK and atr14 > 0 ? (rC - dSma200) / atr14 : na

// 24H price change on the reference series. The left half of MARKET MECHANICS.
px24 = refOK and not na(rC[BARS_PER_DAY]) and rC[BARS_PER_DAY] > 0 ? rC / rC[BARS_PER_DAY] - 1 : na

// BOTH endpoints must be valid observations. The v3.0 guard only checked that
// the OLDER value was positive, so a zero tick on the current bar produced
// 0/x - 1 = -100% and fed it straight into the normalisation window.
oiChg4hRaw  = oiObs and oiObs[1] ? oiRaw / oiRaw[1] - 1 : na
oiChg24hRaw = oiObs and oiObs[BARS_PER_DAY] ? oiRaw / oiRaw[BARS_PER_DAY] - 1 : na
oiChg4h  = oiOK ? oiChg4hRaw : na
oiChg24h = oiOK ? oiChg24hRaw : na

premiumRaw = not na(spotC) and not na(rC) and spotC > 0 ? rC / spotC - 1 : na
// The raw perp/spot premium carries a persistent negative level offset (median
// -0.039% over six years). Its SIGN is still the honest direction word; the
// offset is why the intensity is a rank and never an absolute threshold.
premium = spotOK and refOK ? premiumRaw : na

rvolSpotRaw = slotRvol(spotV, rvolDays)
rvolPerpRaw = slotRvol(rV, rvolDays)
rvolSpot = spotOK ? rvolSpotRaw : na
rvolPerp = refOK ? rvolPerpRaw : na
partOK   = not na(rvolSpot) and not na(rvolPerp) and rvolPerp > 0 and rvolSpot > 0
// Log ratio so a spot surge and a perp surge are symmetric around zero.
partRawU = not na(rvolSpotRaw) and not na(rvolPerpRaw) and rvolSpotRaw > 0 and rvolPerpRaw > 0 ? math.log(rvolSpotRaw / rvolPerpRaw) : na
partRaw  = partOK ? partRawU : na

// Five days of ETF flow, computed to match what one observation of the source
// actually represents. Both forms are evaluated unconditionally and one is
// selected, so math.sum's window never has a hole in it.
// THREE DIFFERENT SUMS, and only one of them is a five-observation total.
// The row label changes with the mode so the dashboard can never call something
// a five-day flow when it is not one.
//
//   ETF LAST 5 OBS    the last five bars that actually carried a figure. Needs
//                     the na-gated contract. Weekends and holidays are simply
//                     absent, and two consecutive sessions reporting the SAME
//                     number still count twice, because the gate is the na and
//                     not the value.
//   ETF 5 CAL-DAY     one sample per calendar day. If the plot forward-fills,
//                     a Friday figure is re-counted on Saturday and Sunday.
//                     This is a documented defect of the source shape, not of
//                     the arithmetic, and it is why the label says CAL-DAY.
//   ETF 30-BAR SUM    thirty 4H increments.
//
// nz() is correct in the increment branch and only there: a bar with no
// increment genuinely contributed zero flow. It is not correct anywhere else in
// this file.
etfIncr5   = math.sum(nz(extEtf), BARS_PER_DAY * 5)
etfDaily5  = extEtf + extEtf[BARS_PER_DAY] + extEtf[BARS_PER_DAY * 2] + extEtf[BARS_PER_DAY * 3] + extEtf[BARS_PER_DAY * 4]
// 90 bars = 15 calendar days, enough for five sessions to survive two weekends
// and a holiday. Gated: sumLastValid holds no state and calls no ta.* function,
// so the loop is only walked when the shape that needs it is selected.
ETF_MAXBACK = 90
float etfObs5 = na
if etfNaGated
    etfObs5 := sumLastValid(extEtf, 5, ETF_MAXBACK)
etf5dRaw   = etfNaGated ? etfObs5 : etfDailyMode ? etfDaily5 : etfIncr5
etf5d      = etfOK ? etf5dRaw : na
etfRowLbl  = etfNaGated ? "ETF LAST 5 OBS" : etfDailyMode ? "ETF 5 CAL-DAY" : "ETF 30-BAR SUM"
// Only the na-gated shape can tell a new observation from a repeat, so only it
// can keep repeats out of the normalisation window.
etfSample  = etfNaGated ? (na(extEtf) ? na : etf5dRaw) : etf5dRaw

soprDevU = not na(soprD) ? soprD - 1.0 : na
soprDev  = soprOK ? soprDevU : na
// SOPR is a DAILY figure delivered on all six 4H bars of the day by
// request.security's forward fill. Its bar time is available, so a new
// observation is identifiable exactly — no value-change guessing required.
soprObsU = not na(soprT) and (na(soprT[1]) or soprT != soprT[1]) ? soprDevU : na

// Liquidation balance. The ratio is dimensionless, which is NOT the same as
// unit-free: (L - S) / (L + S) subtracts one feed from the other, so it means
// something only when both are the same quantity, in the same unit, from the
// same provider. Two mismatched scales also land inside [-1, +1] and look
// perfectly reasonable. So the pairing has to be declared, and without the
// declaration the balance is not computed at all.
liqSum   = (na(extLiqL) ? 0.0 : extLiqL) + (na(extLiqS) ? 0.0 : extLiqS)
liqBalU  = liqSum > 0 ? ((na(extLiqL) ? 0.0 : extLiqL) - (na(extLiqS) ? 0.0 : extLiqS)) / liqSum : na
liqBalOK = liqLOK and liqSOK and liqPaired
liqBal   = liqBalOK ? liqBalU : na

// -------------------------------------- 6. normalisation: percentile and z ---
// Computed unconditionally, masked afterwards. Same window for both, so the
// rank and the σ always describe the same history.
// Every measure is normalised against the VALID OBSERVATIONS in its window.
// A bar with no observation is skipped: it is not zero, not a repeat, and it
// does not occupy a slot. z and percentile come out of one pass over one sample
// set, so they can never describe different histories.
minSamp = math.max(30, zWin / 4)
minDaily = 10                                  // SOPR: ~30 daily obs in 180 bars

[oiZ4U,  oiP4U,  oiN4 ]  = validNorm(oiChg4hRaw,  oiChg4hRaw,  zWin, minSamp)
[oiZ24U, oiP24U, oiN24]  = validNorm(oiChg24hRaw, oiChg24hRaw, zWin, minSamp)
[premZU, premPU, premN]  = validNorm(premiumRaw,  premiumRaw,  zWin, minSamp)
[partZU, partPU, partN]  = validNorm(partRawU,    partRawU,    zWin, minSamp)
[rvSpZU, rvSpPU, rvSpN]  = validNorm(rvolSpotRaw, rvolSpotRaw, zWin, minSamp)
[rvPpZU, rvPpPU, rvPpN]  = validNorm(rvolPerpRaw, rvolPerpRaw, zWin, minSamp)
[soprZU, soprPU, soprN]  = validNorm(soprObsU,    soprObsU,    zWin, minDaily)

// The four adapter windows are only walked when their adapter is on. validNorm
// holds no state and calls no ta.* function, so a conditional call is safe here
// — which is NOT true of anything else in this file, and is the only reason the
// gate is allowed. It keeps the default configuration down to seven window
// walks per bar instead of eleven.
float fundZU = na
float fundPU = na
float etfZU  = na
float etfPU  = na
float liqLZU = na
float liqLPU = na
float liqSZU = na
float liqSPU = na
float liqBZU = na
float liqBPU = na
if useFunding
    [z, p, n] = validNorm(fundCanon, fundCanon, zWin, minSamp)
    fundZU := z
    fundPU := p
if useEtf
    [z, p, n] = validNorm(etf5dRaw, etfSample, zWin, etfNaGated ? minDaily : minSamp)
    etfZU := z
    etfPU := p
if useLiqL
    [z, p, n] = validNorm(extLiqL, extLiqL, zWin, minSamp)
    liqLZU := z
    liqLPU := p
if useLiqS
    [z, p, n] = validNorm(extLiqS, extLiqS, zWin, minSamp)
    liqSZU := z
    liqSPU := p
if useLiqL and useLiqS
    [z, p, n] = validNorm(liqBalU, liqBalU, zWin, minSamp)
    liqBZU := z
    liqBPU := p

// OI 24H takes EMA(2) on its z before the ladder. It was the only candidate
// that cleared every gate in the stability audit: label run 2 -> 3 bars, 100%
// retention at 1.5/2.0/2.5σ, median delay 0. EMA(3) and EMA(4) pushed P90 delay
// to 3-4 bars for no further gain. Smoothed value drives the LADDER only; the
// raw z and the raw percentage are always displayed.
oiZ24sU = ta.ema(oiZ24U, 2)

oiZ4   = oiOK ? oiZ4U : na
oiZ24  = oiOK ? oiZ24U : na
oiZ24s = oiOK ? oiZ24sU : na
oiP4   = oiOK ? oiP4U : na
oiP24  = oiOK ? oiP24U : na
premZ  = na(premium) ? na : premZU
premP  = na(premium) ? na : premPU
partZ  = partOK ? partZU : na
partP  = partOK ? partPU : na
rvolSpotZ = not na(rvolSpot) ? rvSpZU : na
rvolSpotP = not na(rvolSpot) ? rvSpPU : na
rvolPerpZ = not na(rvolPerp) ? rvPpZU : na
rvolPerpP = not na(rvolPerp) ? rvPpPU : na
fundZ  = fundOK ? fundZU : na
fundP  = fundOK ? fundPU : na
etfZ   = etfOK ? etfZU : na
etfP   = etfOK ? etfPU : na
liqLZ  = liqLOK ? liqLZU : na
liqLP  = liqLOK ? liqLPU : na
liqSZ  = liqSOK ? liqSZU : na
liqSP  = liqSOK ? liqSPU : na
liqBZ  = liqBalOK ? liqBZU : na
liqBP  = liqBalOK ? liqBPU : na
fundRaw = fundOK ? fundCanon : na
soprP   = soprOK ? soprPU : na

// ============================== 7. REGIME / IMPULSE / CONTEXT ================
// Not every measurement deserves the same product shape. A stability audit
// (audit/smoothing-audit.mjs and audit/oi4h-deseasonalization.mjs, gates taken
// from the brief: label run >= 3 bars, median detection delay <= 1, >= 90%
// retention of events at and above the measure's own entry threshold) sorted
// them:
//   REGIME   readable enough to hold a persistent state
//   IMPULSE  no smoothing and no de-seasonalisation made it readable without
//            destroying the extremes it exists to report — so it is reported as
//            an instantaneous spike. Zero latency, no state to flicker, nothing
//            claimed to persist, and it never appears as a regime transition.
//   CONTEXT  slow external feeds
//
// Every mag()/sch() call must run unconditionally on every bar: a skipped call
// leaves that call site's `var` permanently out of step.

// --- REGIME ---
[trSt,    trPrev]   = sch(trendDist, trEnter, trExit)
[oi24Lvl, oi24PrevL] = mag(oiZ24s, oiEnter, oiExit, oiXEnter, oiXExit)

// --- CONTEXT --- slow feeds; daily by nature, so not flicker-prone.
[fdLvl, fdPrevL] = mag(fundZ, fundEnter, fundExit, fundXEnter, fundXExit)
[etLvl, etPrevL] = mag(etfZ, etfEnter, etfExit, etfXEnter, etfXExit)
[spSt,  spPrev]  = sch(soprDev, soprEnter, soprExit)
[lqLLvlRaw, lqLPrevL] = mag(liqLZ, liqEnter, liqExit, liqXEnter, liqXExit)
[lqSLvlRaw, lqSPrevL] = mag(liqSZ, liqEnter, liqExit, liqXEnter, liqXExit)
// Liquidation volume has a floor at zero, so only the upper tail is an event.
// A below-average liquidation bar is not "unusually few liquidations", it is a
// quiet market, and the radar has nothing to say about it.
lqLLvl = not na(liqLZ) and liqLZ > 0 ? lqLLvlRaw : 0
lqSLvl = not na(liqSZ) and liqSZ > 0 ? lqSLvlRaw : 0

// --- IMPULSE --- fired from the RAW z, deliberately: the point of an impulse
// is that it is reported the moment it happens.
oi4Lvl = oiOK ? imp(oiZ4, oiEnter, oiXEnter) : 0
pmLvl  = imp(premZ, premEnter, premXEnter)
ptLvl  = partOK ? imp(partZ, partEnter, partEnter * 2) : 0
rsLvl  = imp(rvolSpotZ, rvolEnter, rvolEnter * 1.8)
rpLvl  = imp(rvolPerpZ, rvolEnter, rvolEnter * 1.8)

// ------------------------------------- 8. directions, from the RAW value ----
// This is the v3 correctness rule in code. Every direction word below is a
// function of a raw measurement's sign and of nothing else. The invariants
// EXPANSION => oiChg24h > 0, INFLOW => etf5d > 0, LONG FUNDING => funding > 0,
// POSITIVE PREMIUM => premium > 0 are asserted over every bar in tests.mjs.
oi24Dir = dirOf(oiChg24h)
oi4Dir  = dirOf(oiChg4h)
pmDir   = dirOf(premium)
fdDir   = dirOf(fundRaw)
etDir   = dirOf(etf5d)
lqBDir  = dirOf(liqBal)
// Participation is a RELATIVE measure: "surge" means unusual versus its own
// history, which is a statement about the z and not about the raw ratio. Its
// direction word therefore comes from the z sign, and the words say "RELATIVE"
// so they cannot be read as dominance. partRaw > 0 only means spot RVOL
// exceeded perp RVOL, which is true most of the time and means nothing.
ptDir   = na(partZ) ? 0 : dirOf(partZ)
rsDir   = na(rvolSpotZ) ? 0 : dirOf(rvolSpotZ)
rpDir   = na(rvolPerpZ) ? 0 : dirOf(rvolPerpZ)

// Composite state codes: intensity x direction, so one integer carries both
// axes and a transition can be described from its previous value alone.
// One composite is kept, purely as a test hook: audit/hysteresis-verify.mjs
// cross-checks its JavaScript model of the ladder against it on every bar.
// Nothing in the display reads it — every label takes the two axes separately.
oi24St = oi24Lvl * oi24Dir

// ------------------------------------------------------- 9. state labels ----
intWord(lvl)  => lvl >= 2 ? "EXTREME" : lvl == 1 ? "UNUSUAL" : "NORMAL"
fundWord(lvl) => lvl >= 2 ? "EXTREME" : lvl == 1 ? "ELEVATED" : "NORMAL"

// Every phrase takes the two axes SEPARATELY — intensity from the ladder,
// direction from the raw sign. Keeping them as two arguments rather than one
// signed code means a raw value of exactly zero prints "FLAT" instead of
// silently collapsing an engaged measure back to "NORMAL".
oiPhrase(lvl, dir) =>
    lvl == 0 ? "NORMAL" : intWord(lvl) + (dir > 0 ? " EXPANSION" : dir < 0 ? " REDUCTION" : " FLAT")
fundPhrase(lvl, dir) =>
    lvl == 0 ? "NORMAL" : fundWord(lvl) + (dir > 0 ? " LONG FUNDING" : dir < 0 ? " SHORT FUNDING" : " FLAT FUNDING")
etfPhrase(lvl, dir) =>
    lvl == 0 ? "NORMAL" : intWord(lvl) + (dir > 0 ? " INFLOW" : dir < 0 ? " OUTFLOW" : " FLAT")
premPhrase(lvl, dir) =>
    lvl == 0 ? "NORMAL" : intWord(lvl) + (dir > 0 ? " POSITIVE PREMIUM" : dir < 0 ? " NEGATIVE PREMIUM" : " FLAT PREMIUM")
partPhrase(lvl, dir) =>
    lvl == 0 or dir == 0 ? "NORMAL RELATIVE ACTIVITY" : (lvl >= 2 ? "EXTREME " : "") + (dir > 0 ? "RELATIVE SPOT SURGE" : "RELATIVE PERP SURGE")
rvolPhrase(lvl, dir) =>
    lvl == 0 or dir == 0 ? "NORMAL" : intWord(lvl) + (dir > 0 ? " HIGH VOLUME" : " LOW VOLUME")
liqPhrase(lvl, side) =>
    lvl == 0 ? "NORMAL" : (lvl >= 2 ? "EXTREME " : "") + side + " LIQUIDATION SPIKE"

// Trend and SOPR: the raw value is itself the deviation, so sign(state) equals
// sign(raw) by construction. The words stay descriptive — where price sits
// relative to a moving average, not what that implies.
trendPhrase(st) =>
    st > 0 ? "ABOVE 200D" : st < 0 ? "BELOW 200D" : "NEAR 200D"
soprPhrase(st) =>
    st > 0 ? "ABOVE 1 — PROFIT REALIZATION" : st < 0 ? "BELOW 1 — LOSS REALIZATION" : "NEAR 1"

// TWO VOCABULARIES, because two different things are being measured.
//
// statWord / statWordD describe a TIMESTAMP-VERIFIED feed. The symbol returns
// its own bar time, so the lag is measured and FRESH means fresh.
statWord(s)  => s == 4 ? "FRESH" : s == 3 ? "1 BAR OLD" : s == 2 ? "STALE" : s == 1 ? "MISCONFIGURED" : "UNAVAILABLE"
statWordD(s) => s == 4 ? "FRESH" : s == 3 ? "1D OLD" : s == 2 ? "STALE" : s == 1 ? "MISCONFIGURED" : "UNAVAILABLE"
// adaptWord describes an input.source() adapter, which has no upstream
// timestamp at all. The only observable is whether the number moved, so these
// words report UPDATE ACTIVITY and deliberately never say "fresh". A live feed
// repeating a legitimate value reads LIKELY STALE too, and that is a false
// positive the vocabulary is built to admit rather than hide.
adaptWord(s) => s == 4 ? "ACTIVE" : s == 3 ? "UNCHANGED 1 BAR" : s == 2 ? "LIKELY STALE" : s == 1 ? "MISCONFIGURED" : "UNAVAILABLE"

// THREE ROLES, NEVER MIXED — the reading order of every measure row is
//   RAW VALUE   what happened, and the direction word. Nothing else decides it.
//   Z-SCORE     state intensity, through the hysteresis ladder.
//               NORMAL / UNUSUAL / EXTREME. Marked [σ] on the dashboard.
//   PERCENTILE  historical rarity, and the ranking used to order ANOMALIES.
// The percentile does not decide the state and never has. It is shown first
// because it makes no normality assumption; the state is marked [σ] so that a
// row reading "99.4p ... NORMAL [σ]" is legible as two different statements
// rather than as a bug.
SIG = " [σ]"

trendLbl = not dailyOK ? "DATA UNAVAILABLE" : trendPhrase(trSt)
volLbl   = na(volPct) ? "DATA UNAVAILABLE" : volPct > 80 ? "HIGH" : volPct > 55 ? "ELEVATED" : volPct < 20 ? "COMPRESSED" : "NORMAL"
oi24Lbl  = not oiOK ? "DATA UNAVAILABLE" : oiPhrase(oi24Lvl, oi24Dir) + SIG
oi4Lbl   = not oiOK ? "DATA UNAVAILABLE" : oiPhrase(oi4Lvl, oi4Dir) + SIG
fundLbl  = not fundOK ? adaptWord(fdStat) : fundPhrase(fdLvl, fdDir) + SIG
premLbl  = na(premium) ? "DATA UNAVAILABLE" : premPhrase(pmLvl, pmDir) + SIG
partLbl  = not partOK ? "DATA UNAVAILABLE" : partPhrase(ptLvl, ptDir) + SIG
rsLbl    = na(rvolSpotZ) ? "DATA UNAVAILABLE" : rvolPhrase(rsLvl, rsDir) + SIG
rpLbl    = na(rvolPerpZ) ? "DATA UNAVAILABLE" : rvolPhrase(rpLvl, rpDir) + SIG
etfLbl   = not etfOK ? adaptWord(etStat) : etfPhrase(etLvl, etDir) + SIG
soprLbl  = not soprOK ? "DATA UNAVAILABLE" : soprPhrase(spSt)
liqLLbl  = not liqLOK ? adaptWord(lLStat) : liqPhrase(lqLLvl, "LONG") + SIG
liqSLbl  = not liqSOK ? adaptWord(lSStat) : liqPhrase(lqSLvl, "SHORT") + SIG
liqBLbl  = not liqOK ? "DATA UNAVAILABLE" : not liqPaired ? "DATA INCOMPARABLE" : lqBDir > 0 ? "MORE LONG LIQUIDATIONS" : lqBDir < 0 ? "MORE SHORT LIQUIDATIONS" : "BALANCED"

// ----------------------------------- 9b. Decision vocabulary (display only) --
// PLAIN ENGLISH FOR THE DECISION PANEL, AND NOTHING ELSE.
//
// Every sentence below is a DETERMINISTIC TRANSLATION of a state that already
// exists above. Nothing is recomputed, no threshold is read, no new measurement
// is introduced, and no phrase can exist unless its research-vocabulary twin
// exists first — the two are two renderings of one state, not two states.
//
// A reader should not have to know what a Schmitt trigger, a σ ladder, an
// impulse or a percentile disagreement is in order to use this panel. Those
// words are correct, and they belong in Detailed and Debug.

// --- TREND, in five words ---
// A deterministic sum of two price-derived states the script already computes:
// where price sits relative to the confirmed daily 200MA (trSt, a Schmitt state
// in ATR units) and the sign of 12-week momentum. Both are descriptions of the
// past. STRONG UP means "above the 200D AND up over twelve weeks" and means
// nothing else — in particular it is NOT a forecast, and the audit that deleted
// the action layer found no direction-consistent edge in any trend state.
trendScore = (trSt > 0 ? 1 : trSt < 0 ? -1 : 0) + (na(dMom12w) ? 0 : dMom12w > 0 ? 1 : dMom12w < 0 ? -1 : 0)
kTrendWord = not dailyOK or na(dMom12w) ? "NO DATA" : trendScore >= 2 ? "STRONG UP" : trendScore == 1 ? "UP" : trendScore == 0 ? "MIXED" : trendScore == -1 ? "DOWN" : "STRONG DOWN"

// --- POSITIONING, from the OI 24H ladder ---
// NORMAL covers the whole unengaged band. There is no separate "OI BUILDING"
// tier because producing one would need a new threshold on the raw 24H change,
// and inventing a threshold is exactly what this revision is not allowed to do.
kPosWord = not oiOK ? "NO DATA" : oi24Lvl == 0 ? "NORMAL" : (oi24Lvl >= 2 ? "EXTREME " : "UNUSUAL ") + (oi24Dir > 0 ? "BUILD" : oi24Dir < 0 ? "REDUCTION" : "FLAT")


// --- one sentence per anomaly, for MAIN THING TO WATCH ---
// Descriptions of what has already happened. None of them says what follows,
// because nothing in six years of audited history supports saying it.
sInt(lvl)       => lvl >= 2 ? "Extreme" : "Unusual"
sOi(lvl, dir, w)  => sInt(lvl) + " open interest " + (dir > 0 ? "increase" : dir < 0 ? "reduction" : "move") + " over the last " + w + "."
sFund(lvl, dir) => "Funding is " + (lvl >= 2 ? "extremely " : "unusually ") + (dir > 0 ? "positive — longs are paying shorts." : dir < 0 ? "negative — shorts are paying longs." : "flat.")
sPrem(lvl, dir) => "Perpetual is trading at " + (lvl >= 2 ? "an extreme " : "an unusual ") + (dir > 0 ? "premium to spot." : dir < 0 ? "discount to spot." : "level against spot.")
sPart(dir)      => (dir > 0 ? "Spot" : "Perpetual") + " activity spike relative to the other venue."
sRvol(dir, w)   => w + " volume is unusually " + (dir > 0 ? "high" : "low") + " for this time of day."
sLiq(side)      => "Large " + side + "-liquidation spike detected."
sEtf(lvl, dir)  => sInt(lvl) + " ETF net " + (dir > 0 ? "inflow." : dir < 0 ? "outflow." : "flow.")
sSopr(st)       => st > 0 ? "SOPR is above 1 — coins are being sold at a profit." : "SOPR is below 1 — coins are being sold at a loss."


// =========================================================== 10. anomalies ===
// A measurement is anomalous when its intensity ladder is engaged. Ranked by
// PERCENTILE EXTREMENESS — how far into either tail of its own empirical
// distribution it sits — so the ordering makes no normality assumption.
var array<string> aName = array.new_string(0)
var array<float>  aExt  = array.new_float(0)
var array<float>  aZ    = array.new_float(0)
var array<float>  aPct  = array.new_float(0)
// Two DISPLAY-ONLY columns, pushed by the same call so they can never drift out
// of step with the measurement they describe: the plain-English sentence the
// Decision panel prints, and the ATTENTION PRIORITY used to pick which single
// anomaly it prints.
//
// Attention priority is a READABILITY ordering, not a significance claim. It
// says that when several things are unusual at once and there is room for one
// line, a broken feed outranks an extreme funding rate which outranks a volume
// blip. It does not say that any of them predicts anything, and it is not the
// ordering CURRENT ANOMALIES uses — that one is percentile extremeness, which
// is a property of the data rather than of the reader.
//   1 core data failure  2 extreme/unusual OI   3 funding   4 premium
//   5 liquidation spike  6 trend transition     7 ETF / SOPR
//   8 participation / RVOL
var array<string> aSent = array.new_string(0)
var array<float>  aPrio = array.new_float(0)
array.clear(aName)
array.clear(aExt)
array.clear(aZ)
array.clear(aPct)
array.clear(aSent)
array.clear(aPrio)

addAnom(name, prio, sentence, engaged, phrase, p, z) =>
    if engaged and not na(z)
        array.push(aName, name + " " + phrase)
        array.push(aExt, na(p) ? 50.0 + math.min(math.abs(z) * 10.0, 49.0) : extOf(p))
        array.push(aZ, z)
        array.push(aPct, na(p) ? na : p)
        array.push(aSent, sentence)
        // Priority dominates; percentile extremeness breaks ties within a
        // priority, so the more unusual of two OI readings wins.
        array.push(aPrio, prio * 1000.0 - (na(p) ? 50.0 : extOf(p)))

// Regimes and impulses both belong here — the radar answers "what is unusual
// right now", and an instantaneous spike is unusual right now. The distinction
// lives in WHAT CHANGED, which reports regime transitions only.
// A trailing * marks an IMPULSE: this bar, not a regime.
addAnom("OI 24H",      2, sOi(oi24Lvl, oi24Dir, "24 hours"), oi24Lvl != 0, oiPhrase(oi24Lvl, oi24Dir), oiP24,  oiZ24)
addAnom("OI 4H *",     2, sOi(oi4Lvl, oi4Dir, "4 hours"),    oi4Lvl != 0,  oiPhrase(oi4Lvl, oi4Dir),   oiP4,   oiZ4)
addAnom("FUNDING",     3, sFund(fdLvl, fdDir),               fdLvl != 0,   fundPhrase(fdLvl, fdDir),   fundP,  fundZ)
addAnom("PREMIUM *",   4, sPrem(pmLvl, pmDir),               pmLvl != 0,   premPhrase(pmLvl, pmDir),   premP,  premZ)
addAnom("PARTICIP *",  8, sPart(ptDir),                      ptLvl != 0,   partPhrase(ptLvl, ptDir),   partP,  partZ)
addAnom("SPOT RVOL *", 8, sRvol(rsDir, "Spot"),              rsLvl != 0,   rvolPhrase(rsLvl, rsDir),   rvolSpotP, rvolSpotZ)
addAnom("PERP RVOL *", 8, sRvol(rpDir, "Perpetual"),         rpLvl != 0,   rvolPhrase(rpLvl, rpDir),   rvolPerpP, rvolPerpZ)
addAnom("LONG LIQ *",  5, sLiq("long"),                      lqLLvl != 0,  liqPhrase(lqLLvl, "LONG"),  liqLP, liqLZ)
addAnom("SHORT LIQ *", 5, sLiq("short"),                     lqSLvl != 0,  liqPhrase(lqSLvl, "SHORT"), liqSP, liqSZ)
addAnom(etfRowLbl,     7, sEtf(etLvl, etDir),                etLvl != 0,   etfPhrase(etLvl, etDir),    etfP,   etfZ)
addAnom("SOPR",        7, sSopr(spSt),                       spSt != 0,    soprPhrase(spSt),   soprP,  soprDev)

anomCount = array.size(aName)

// ==================================================== 11. market mechanics ===
// Replaces v2's ALIGNMENT count. Counting how many series moved the same way
// implied that agreement across price, OI, funding, premium and RVOL is one
// thing; it is not — they are different quantities with different economics,
// and "5/5 aligned" was a number with no referent.
//
// This is the one pairing whose joint reading has a definition rather than a
// vote: price direction against position direction over the same 24 hours.
// It is a DESCRIPTION of the mechanics. It is not bullish or bearish.
mechOK  = refOK and oiOK and not na(px24) and not na(oiChg24h)
mechPx  = dirOf(px24)
mechOi  = dirOf(oiChg24h)
mechLbl = not mechOK ? "INSUFFICIENT DATA" : mechPx == 0 or mechOi == 0 ? "FLAT" : mechPx > 0 and mechOi > 0 ? "PRICE UP + POSITION BUILD" : mechPx > 0 and mechOi < 0 ? "PRICE UP + POSITION REDUCTION" : mechPx < 0 and mechOi > 0 ? "PRICE DOWN + POSITION BUILD" : "PRICE DOWN + POSITION REDUCTION"
// The same fact as mechLbl, written as English. "PRICE UP + POSITION REDUCTION"
// is a state name; this is what it means, in words a reader does not have to
// decode. Both sentences are pure description — what price did, what open
// interest did — and neither says whether that is good or bad, because the
// audit found no direction-consistent edge in any of the four combinations.
mechSent = not mechOK or mechPx == 0 or mechOi == 0 ? "" : (mechPx > 0 ? "Price rose" : "Price fell") + " while open interest " + (mechOi > 0 ? "rose" : "fell") + ". Positions were " + (mechOi > 0 ? "added to" : "reduced") + " during the " + (mechPx > 0 ? "rise" : "fall") + "."

// Attached description, never converted into an implication.
mechNote =(fundOK ? "funding " + (fdDir > 0 ? "positive" : fdDir < 0 ? "negative" : "flat") + (fdLvl > 0 ? " (" + str.lower(fundWord(fdLvl)) + ")" : "") : "funding n/a") + " · " + (na(premium) ? "premium n/a" : "premium " + (pmDir > 0 ? "positive" : pmDir < 0 ? "negative" : "flat") + (pmLvl > 0 ? " (" + str.lower(intWord(pmLvl)) + ")" : "")) + " · " + (na(rvolPerpZ) ? "perp RVOL n/a" : "perp RVOL " + (rpLvl > 0 and rpDir > 0 ? "high" : rpLvl > 0 and rpDir < 0 ? "low" : "normal"))

// ======================================================= 12. what changed ====
// Compared with the last CONFIRMED bar, so a forming bar shows a provisional
// diff rather than silently overwriting history. REGIME and CONTEXT only: an
// impulse has no previous state to have changed from, and listing one here
// would report noise as a transition.
// A transition is a change in the PAIR, so a direction flip at an unchanged
// intensity is reported as CHANGED rather than silently overwritten.
//   0 nothing   1 NEW (was normal)   2 NORMALIZED (now normal)   3 CHANGED
chKind(lvl, dir, pLvl, pDir) =>
    // Both normal: nothing to report, whatever the raw sign did. Without this
    // first branch a sign flip inside the normal band would be announced as a
    // new regime, which is exactly the noise WHAT CHANGED exists to filter.
    lvl == 0 and pLvl == 0 ? 0 : lvl == pLvl and dir == pDir ? 0 : pLvl == 0 ? 1 : lvl == 0 ? 2 : 3

kTr = chKind(math.abs(trSt), trSt, math.abs(trPrev), trPrev)
kOi = chKind(oi24Lvl, oi24Dir, oi24PrevL, oi24Dir[1])
kFd = chKind(fdLvl, fdDir, fdPrevL, fdDir[1])
kEt = chKind(etLvl, etDir, etPrevL, etDir[1])
kSp = chKind(math.abs(spSt), spSt, math.abs(spPrev), spPrev)

chNew = (kTr == 1 ? "  Trend entered " + str.lower(trendPhrase(trSt)) + "\n" : "") + (kOi == 1 ? "  OI 24H entered " + str.lower(oiPhrase(oi24Lvl, oi24Dir)) + "\n" : "") + (kFd == 1 ? "  Funding entered " + str.lower(fundPhrase(fdLvl, fdDir)) + "\n" : "") + (kEt == 1 ? "  ETF entered " + str.lower(etfPhrase(etLvl, etDir)) + "\n" : "") + (kSp == 1 ? "  SOPR moved " + str.lower(soprPhrase(spSt)) + "\n" : "")
chNorm = (kTr == 2 ? "  Trend returned to near the 200D\n" : "") + (kOi == 2 ? "  OI 24H returned to normal\n" : "") + (kFd == 2 ? "  Funding returned to normal\n" : "") + (kEt == 2 ? "  ETF returned to normal\n" : "") + (kSp == 2 ? "  SOPR returned to near 1\n" : "")
chChg = (kTr == 3 ? "  Trend " + str.lower(trendPhrase(trPrev)) + " → " + str.lower(trendPhrase(trSt)) + "\n" : "") + (kOi == 3 ? "  OI 24H " + str.lower(oiPhrase(oi24PrevL, oi24Dir[1])) + " → " + str.lower(oiPhrase(oi24Lvl, oi24Dir)) + "\n" : "") + (kFd == 3 ? "  Funding " + str.lower(fundPhrase(fdPrevL, fdDir[1])) + " → " + str.lower(fundPhrase(fdLvl, fdDir)) + "\n" : "") + (kEt == 3 ? "  ETF " + str.lower(etfPhrase(etPrevL, etDir[1])) + " → " + str.lower(etfPhrase(etLvl, etDir)) + "\n" : "") + (kSp == 3 ? "  SOPR " + str.lower(soprPhrase(spPrev)) + " → " + str.lower(soprPhrase(spSt)) + "\n" : "")

changes = (str.length(chNew) > 0 ? "NEW:\n" + chNew : "") + (str.length(chNorm) > 0 ? "NORMALIZED:\n" + chNorm : "") + (str.length(chChg) > 0 ? "CHANGED:\n" + chChg : "")
changed = str.length(changes) > 0

// ==================================== 13. recent events, alerts, and both =====
// One buffer, written ONLY on a confirmed 4H close. Duplicate suppression is
// two-layer: every trigger below is edge-gated (a transition, or an impulse
// whose previous bar was quiet), and pushEvent additionally refuses a line
// identical to the one already at the top of the buffer.
var array<string> evTxt = array.new_string(0)
var array<int>    evT   = array.new_int(0)
// Pine functions cannot assign to an outer scalar, so the two counters live in
// one-element arrays. [0] accepted pushes, [1] duplicates suppressed. Both are
// plotted as test hooks.
var array<int> evStat = array.new_int(2, 0)
// The most recently accepted line, held in a one-element array that is never
// empty. Reading evTxt's tail directly would mean indexing an empty array on
// the first event, which is a bounds error in some runtimes even behind a
// short-circuit guard.
var array<string> evLast = array.new_string(1, "")

EV_MAX = 5

pushEvent(txt) =>
    dup = array.get(evLast, 0) == txt
    if not dup
        array.push(evTxt, txt)
        array.push(evT, time)
        if array.size(evTxt) > EV_MAX
            array.shift(evTxt)
            array.shift(evT)
        array.set(evLast, 0, txt)
    // Both counters on one line at the end, and every block above finishes on a
    // void array.set(). array.shift() RETURNS the element it removed, so ending
    // a branch on it gave that branch a `series int` type while the sibling
    // branch was void — Pine cannot unify those and refuses to compile
    // (CE10235). PineTS does no type checking at all, so the offline suite ran
    // this happily for three versions.
    array.set(evStat, dup ? 1 : 0, array.get(evStat, dup ? 1 : 0) + 1)

// alert() is silent unless the user created an alert on the script, so firing
// and recording together costs nothing and keeps the two lists identical.
fire(txt) =>
    alert(txt, alert.freq_once_per_bar_close)
    pushEvent(txt)

// Feed status transitions. One call site each, unconditional, per-call-site var.
// `down` and `up` are passed in so a timestamp-verified feed can say STALE while
// an adapter says only that it stopped updating. The alert must not claim to
// know more than the measurement does.
statusEvent(name, st, confirmed, down, up) =>
    var int prev = -1
    string msg = ""
    if confirmed
        if prev >= 0
            if st == 2 and prev != 2
                msg := name + " " + down
            else if st >= 3 and prev < 3
                msg := name + " " + up
        prev := st
    msg

conf = barstate.isconfirmed
TS_DOWN = "data became STALE"
TS_UP   = "data available again"
AD_DOWN = "stopped updating (LIKELY STALE)"
AD_UP   = "started updating again"
seRef  = statusEvent("Reference", refStat, conf, TS_DOWN, TS_UP)
seSpot = statusEvent("Spot", spotStat, conf, TS_DOWN, TS_UP)
seOi   = statusEvent("Open interest", oiStat, conf, TS_DOWN, TS_UP)
seSp   = statusEvent("SOPR", soprStat, conf, TS_DOWN, TS_UP)
seFd   = statusEvent("Funding adapter", fdStat, conf, AD_DOWN, AD_UP)
seEt   = statusEvent("ETF adapter", etStat, conf, AD_DOWN, AD_UP)
seLl   = statusEvent("Long liquidation adapter", lLStat, conf, AD_DOWN, AD_UP)
seLs   = statusEvent("Short liquidation adapter", lSStat, conf, AD_DOWN, AD_UP)

if conf
    // --- regime and context transitions ---
    if kOi != 0 and oi24Lvl != 0
        fire("OI 24H " + str.lower(oiPhrase(oi24Lvl, oi24Dir)) + " " + pRank(oiP24) + " (" + pctS(oiChg24h) + ")")
    if kOi == 2
        fire("OI 24H returned to normal")
    if kFd != 0 and fdLvl != 0
        fire("Funding " + str.lower(fundPhrase(fdLvl, fdDir)) + " " + pRank(fundP))
    // One line per ETF change, not two: a direction flip already says what the
    // new state is, so the generic "entered" line would only repeat it.
    if kEt == 3
        fire(etfRowLbl + " " + str.lower(etfPhrase(etPrevL, etDir[1])) + " → " + str.lower(etfPhrase(etLvl, etDir)) + " " + pRank(etfP))
    else if kEt != 0 and etLvl != 0
        fire(etfRowLbl + " " + str.lower(etfPhrase(etLvl, etDir)) + " " + pRank(etfP))
    if kTr != 0
        fire("Slow trend → " + str.lower(trendPhrase(trSt)) + " (" + sgn2(trendDist) + " ATR)")
    if soprOK and not na(soprD[1]) and ((soprD > 1 and soprD[1] <= 1) or (soprD < 1 and soprD[1] >= 1))
        fire("SOPR crossed 1 → " + f2(soprD))
    // --- impulses: this bar only, suppressed while already spiking ---
    if oi4Lvl != 0 and oi4Lvl[1] == 0
        fire("OI 4H " + str.lower(oiPhrase(oi4Lvl, oi4Dir)) + " " + pRank(oiP4) + " (" + pctS(oiChg4h) + ")")
    if pmLvl != 0 and pmLvl[1] == 0
        fire("Premium " + str.lower(premPhrase(pmLvl, pmDir)) + " " + pRank(premP) + " (" + pct4(premium) + ")")
    if ptLvl != 0 and ptLvl[1] == 0
        fire("Participation: " + str.lower(partPhrase(ptLvl, ptDir)) + " " + pRank(partP))
    if lqLLvl != 0 and lqLLvl[1] == 0
        fire("Long liquidation spike " + pRank(liqLP))
    if lqSLvl != 0 and lqSLvl[1] == 0
        fire("Short liquidation spike " + pRank(liqSP))
    // --- data health ---
    if str.length(seRef) > 0
        fire(seRef)
    if str.length(seSpot) > 0
        fire(seSpot)
    if str.length(seOi) > 0
        fire(seOi)
    if str.length(seFd) > 0
        fire(seFd)
    if str.length(seEt) > 0
        fire(seEt)
    if str.length(seLl) > 0
        fire(seLl)
    if str.length(seLs) > 0
        fire(seLs)
    if str.length(seSp) > 0
        fire(seSp)

evCount = array.size(evTxt)

ageStr(t0) =>
    h = math.round((time - t0) / 3600000.0)
    h < 1 ? "now" : h < 48 ? str.tostring(h, "#") + "h" : str.tostring(h / 24.0, "#") + "d"

// ------------------------- 13b. event DISPLAY priority and merging (UI only) --
// This layer READS the event buffer and never writes it. The buffer, the
// alerts, the accepted/suppressed counters and the prospective event log are
// byte-identical to v3.2 — what changes is only which of the five stored lines
// the panel has room to show first, and whether three lines about the same
// thing are printed as three rows or as one.
//
// Ranking order, most important first. It is a READABILITY order, not a
// significance claim: nothing here says a funding event matters more to a
// forecast than an RVOL impulse, only that when five events compete for three
// rows, a dead feed must not be pushed off the panel by a volume blip.
//   1 feed / data failure   2 open interest      3 funding       4 premium
//   5 liquidation spike     6 trend transition   7 ETF or SOPR   8 participation / RVOL
evPrio(t) =>
    str.contains(t, "STALE") or str.contains(t, "data available again") or str.contains(t, "updating") ? 1 : str.startswith(t, "OI ") ? 2 : str.startswith(t, "Funding") ? 3 : str.startswith(t, "Premium") ? 4 : str.contains(t, "liquidation spike") ? 5 : str.startswith(t, "Slow trend") ? 6 : str.startswith(t, "SOPR") or str.contains(t, "ETF") ? 7 : 8

// The grouping key is what a line is ABOUT. Three OI reduction lines four hours
// apart are one ongoing reduction, and printing them as three rows spends the
// whole panel saying one thing. A reduction and an expansion are NOT the same
// subject and never merge; neither does "returned to normal", which is a third
// key, because collapsing it into the reduction would make the panel claim the
// reduction is still running.
evKey(t) =>
    p = evPrio(t)
    p == 2 ? "OI " + (str.contains(t, "reduction") ? "down" : str.contains(t, "expansion") ? "up" : "flat") : p == 5 ? (str.startswith(t, "Long") ? "LIQ long" : "LIQ short") : p == 1 ? "FEED " + t : str.tostring(p)

// The newest line of the group, plus how long the group has been running. The
// age shown is the OLDEST member's, so "repeated 3x over 12h" is literally true
// of the buffer contents.
evLine(txt, cnt, oldT) =>
    cnt <= 1 ? txt : txt + "  — repeated " + str.tostring(cnt) + "x over " + ageStr(oldT)

// ------------------------- 13c. compact data-health summary (display only) ---
// Decision does not list a feed that is working. It states whether the core is
// intact, how many optional adapters are connected, and then lists — in full,
// never truncated — everything that is not.
//
// CORE IS THE FOUR FEEDS EVERY READING DEPENDS ON, and no more: the reference
// perpetual, spot, base-unit open interest, and the confirmed daily 200MA.
// All four are default symbols requiring zero configuration, which is what
// makes "Core OK" a statement about the product rather than about the user's
// setup. SOPR is deliberately NOT core — it is a Glassnode symbol that not
// every plan resolves, nothing in TREND, RISK, RISK BUDGET or POSITIONING
// reads it, and letting it turn Core red would mean reporting a working
// indicator as broken.
coreOK  = refStat >= 3 and spotStat >= 3 and oiStat >= 3 and dailyStat >= 3
nAdOn   = (useFunding ? 1 : 0) + (useEtf ? 1 : 0) + (useLiqL ? 1 : 0) + (useLiqS ? 1 : 0)
nAdConn = (fundOK ? 1 : 0) + (etfOK ? 1 : 0) + (liqLOK ? 1 : 0) + (liqSOK ? 1 : 0)

// MISCONFIGURED is the one adapter state the user can fix in ten seconds, so it
// gets its own heading rather than a line in a list of complaints.
setupTxt = (fdStat == 1 ? "  Funding source not connected\n" : "") + (etStat == 1 ? "  ETF source not connected\n" : "") + (lLStat == 1 ? "  Long liquidation source not connected\n" : "") + (lSStat == 1 ? "  Short liquidation source not connected\n" : "")

// ------------------------ 13d. MAIN THING TO WATCH (display only) -----------
// One line. Chosen by attention priority, not by percentile — the Decision
// panel has room for one thing and it should be the thing a reader would most
// regret not being told.
//
// A trend transition is not an anomaly (a regime CHANGE is not an unusual
// VALUE) so it is not in the anomaly arrays and must not be: pushing it there
// would change anomCount, which is a measured output the test suite asserts
// against the engaged ladders. It competes here instead, at priority 6.
trWatch = kTr == 0 or not dailyOK ? "" : "Trend state changed to " + kTrendWord + " — price moved relative to the 200-day average."

string mainSent = ""
color  mainCol  = color.new(color.orange, 30)
if not coreOK or oiLooksNotional
    mainSent := oiLooksNotional ? "Open interest feed looks USD-denominated. Positioning readings are switched off — point the OI input at a base-unit symbol." : "A core data feed is missing or stale. Readings from it are suppressed — see DATA."
    mainCol  := color.new(color.red, 30)
else
    float  bestP = 99000.0
    string bestS = ""
    if anomCount > 0
        bi = array.sort_indices(aPrio, order.ascending)
        bestP := array.get(aPrio, array.get(bi, 0))
        bestS := array.get(aSent, array.get(bi, 0))
    // 5900 is priority 6's worst possible key (6 * 1000 - 100). Anything
    // numerically above it lost to the trend transition.
    if str.length(trWatch) > 0 and bestP > 5900.0
        bestS := trWatch
    mainSent := bestS

issueTxt = (oiLooksNotional ? "  ⚠ Open interest feed looks USD-denominated — OI readings off\n" : "") + (refStat < 3 ? "  ⚠ Reference price " + str.lower(statWord(refStat)) + "\n" : "") + (spotStat < 3 ? "  ⚠ Spot price " + str.lower(statWord(spotStat)) + "\n" : "") + (oiStat < 3 and not oiLooksNotional ? "  ⚠ Open interest " + str.lower(statWord(oiStat)) + "\n" : "") + (dailyStat < 3 ? "  ⚠ Daily 200MA " + str.lower(statWordD(dailyStat)) + "\n" : "") + (soprStat < 3 ? "  · SOPR context feed " + str.lower(statWordD(soprStat)) + " — not required by any core reading\n" : "") + (fdStat == 2 ? "  ⚠ Funding source may be stale\n" : "") + (etStat == 2 ? "  ⚠ ETF source may be stale\n" : "") + (lLStat == 2 ? "  ⚠ Long liquidation source may be stale\n" : "") + (lSStat == 2 ? "  ⚠ Short liquidation source may be stale\n" : "") + (liqLOK and liqSOK and not liqPaired ? "  ⚠ Liquidation pairing not declared — balance withheld\n" : "")

// =============================================================== 14. table ===
// Worst case is now the DEBUG mode panel: the full Detailed layout (measured at
// 51 rows with 9 anomalies, 5 events and every adapter live) plus the debug
// block. Compact is bounded far below that — its own worst case is asserted
// separately in tests.mjs. Every write is bounds-guarded, so a future section
// cannot silently drop rows off the end; the ceiling is 100 in Pine.
TBL_ROWS = 76

stateCol(raw) =>
    // The [σ] marker is presentation; strip it before matching so a state's
    // colour never depends on whether it carries the marker. Uppercased so the
    // Compact vocabulary ("Unusual reduction") and the Detailed one ("UNUSUAL
    // REDUCTION") land on the same colour — one state, one colour, two
    // renderings.
    s = str.upper(str.replace_all(raw, SIG, ""))
    color c = color.new(color.gray, 40)
    if str.contains(s, "UNAVAILABLE") or s == "INSUFFICIENT DATA" or str.contains(s, "MISCONFIGURED") or s == "NO DATA" or s == "NOT CONNECTED" or s == "NONE ENABLED" or str.contains(s, "NEEDS ~1Y")
        c := color.new(color.gray, 20)
    else if str.contains(s, "STALE") or s == "DATA INCOMPARABLE" or s == "ISSUE" or s == "FEED REJECTED" or s == "SETUP REQUIRED" or s == "CHECK"
        c := color.new(color.red, 25)
    else if s == "NORMAL" or s == "FRESH" or s == "ACTIVE" or s == "BALANCED" or s == "FLAT" or s == "NEAR 200D" or s == "NEAR 1" or s == "NORMAL RELATIVE ACTIVITY" or s == "OK" or s == "CONNECTED"
        c := color.new(color.gray, 55)
    else if str.endswith(s, "NORMAL SIZE") or s == "NO VALIDATED ENTRY / EXIT SIGNAL"
        c := color.new(color.blue, 40)
    else if str.startswith(s, "EXTREME")
        c := color.new(color.orange, 15)
    else if str.startswith(s, "UNUSUAL") or str.startswith(s, "ELEVATED") or str.contains(s, "SPIKE") or str.contains(s, "SURGE")
        c := color.new(color.orange, 35)
    else if s == "HIGH" or str.contains(s, "1 BAR OLD") or str.contains(s, "1D OLD") or str.startswith(s, "UNCHANGED")
        c := color.new(color.blue, 45)
    else
        c := color.new(color.gray, 45)
    c

addRow(t, i, lbl, val, st) =>
    if i < TBL_ROWS
        table.cell(t, 0, i, lbl, text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
        table.cell(t, 1, i, val, text_color = color.new(color.white, 10), text_size = size.tiny, text_halign = text.align_right)
        table.cell(t, 2, i, st,  text_color = color.white, bgcolor = stateCol(st), text_size = size.tiny, text_halign = text.align_left)

wideRow(t, i, txt, bg, sz) =>
    if i < TBL_ROWS
        table.cell(t, 0, i, txt, text_color = color.white, bgcolor = bg, text_size = sz, text_halign = text.align_left)
        table.merge_cells(t, 0, i, 2, i)

// Value cell: RAW first, then the empirical rank, then σ as secondary text.
// The reading order is deliberate — the raw number is what happened, the rank
// is how unusual it is, σ is there for anyone who wants it.
val3(raw, p, z) =>
    (na(raw) ? "n/a" : raw) + "  " + pRank(p) + "  " + (na(z) ? "" : sgn2(z) + "σ")

int rowsUsed = 0
var table dash = na
if showTable and barstate.islast
    pos = tblPos == "Top right" ? position.top_right : tblPos == "Middle right" ? position.middle_right : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Top left" ? position.top_left : position.bottom_left
    // Rebuilt rather than mutated: barstate.islast is true on every forming bar
    // and merged cells cannot be un-merged.
    table.delete(dash)
    dash := table.new(pos, 3, TBL_ROWS, border_width = 1, border_color = color.new(color.gray, 70), frame_width = 1, frame_color = color.new(color.gray, 50))

    int r = 0

    // ---- event display grouping, shared by both layouts (reads only) ----
    // Newest first, so the surviving text of a merged group is the latest line
    // and the recorded age is the earliest.
    gKey  = array.new_string(0)
    gTxt  = array.new_string(0)
    gRank = array.new_float(0)
    gCnt  = array.new_int(0)
    gOld  = array.new_int(0)
    if evCount > 0
        for k = 0 to evCount - 1
            j = evCount - 1 - k
            tx = array.get(evTxt, j)
            tt = array.get(evT, j)
            at = array.indexof(gKey, evKey(tx))
            if at < 0
                array.push(gKey, evKey(tx))
                array.push(gTxt, tx)
                // priority dominates: 1e13 is far above any millisecond
                // timestamp, and negating the time makes the most recent group
                // sort first WITHIN a priority. Both terms stay exact in a
                // float64 (max ~1.2e13, well under 2^53).
                array.push(gRank, evPrio(tx) * 1e13 - tt)
                array.push(gCnt, 1)
                array.push(gOld, tt)
            else
                array.set(gCnt, at, array.get(gCnt, at) + 1)
                array.set(gOld, at, tt)
    gN = array.size(gKey)
    gIdx = array.new_int(0)
    if gN > 0
        gIdx := array.sort_indices(gRank, order.ascending)

    // ================================================= DECISION ==============
    // The default, and the product. It answers five questions and stops:
    //   what state is the market in          TREND
    //   is risk higher than usual            RISK
    //   how much size does that justify      RISK BUDGET
    //   what is the one thing worth looking at   MAIN THING TO WATCH
    //   is the data healthy                  DATA
    // Everything that is behaving normally is absent. No z-score, no
    // percentile, no sample count, no per-feed freshness, no research
    // vocabulary, and no entry or exit signal — there is no validated one to
    // give, which the last row says out loud.
    if modeDecision
        wideRow(dash, r, "BTC 4H DECISION RADAR", color.new(color.blue, 20), size.small)
        r += 1
        addRow(dash, r, "TREND", "", kTrendWord)
        r += 1
        addRow(dash, r, "RISK", "", na(volPct) ? "NO DATA" : volPct > 80 ? "HIGH" : volPct > 55 ? "ELEVATED" : volPct < 20 ? "LOW" : "NORMAL")
        r += 1
        addRow(dash, r, "POSITIONING", "", kPosWord)
        r += 1

        // --- MAIN THING TO WATCH --- exactly one line, or nothing. A broken
        // core feed outranks every reading, because a reading from a feed that
        // is not there is the worst thing this panel could print.
        if str.length(mainSent) > 0
            wideRow(dash, r, "MAIN THING TO WATCH", mainCol, size.tiny)
            r += 1
            wideRow(dash, r, "  " + mainSent + (anomCount > 1 ? "   (+" + str.tostring(anomCount - 1) + " more in Detailed)" : ""), color.new(color.black, 60), size.tiny)
            r += 1
        else
            // Nothing unusual is a result, and it takes one row to say.
            addRow(dash, r, "MARKET ACTIVITY", "", "NORMAL")
            r += 1

        // --- SETUP REQUIRED --- only when the user enabled an adapter and then
        // did not wire it. Never for an adapter they simply left off.
        if str.length(setupTxt) > 0
            wideRow(dash, r, "SETUP REQUIRED", color.new(color.orange, 25), size.tiny)
            r += 1
            wideRow(dash, r, setupTxt, color.new(color.black, 60), size.tiny)
            r += 1

        wideRow(dash, r, "DATA", color.new(color.blue, 55), size.tiny)
        r += 1
        addRow(dash, r, "  Core", "", coreOK ? "OK" : "ISSUE")
        r += 1
        addRow(dash, r, "  Optional", str.tostring(nAdConn) + " / 4 connected", nAdOn == 0 ? "NONE ENABLED" : nAdConn == nAdOn ? "OK" : "CHECK")
        r += 1
        if str.length(issueTxt) > 0
            wideRow(dash, r, issueTxt, color.new(color.black, 60), size.tiny)
            r += 1

        addRow(dash, r, "DESCRIPTIVE MARKET DATA", "", "NO VALIDATED ENTRY / EXIT SIGNAL")
        r += 1

    // ============================== DETAILED and DEBUG =======================
    // The v3.2 panel: every measure with its raw value, its empirical rank and
    // its σ, every feed's freshness, and the full event list.
    if not modeDecision
        wideRow(dash, r, "BTC 4H MARKET RADAR", color.new(color.blue, 20), size.small)
        r += 1

        // --- RECENT EVENTS ---
        if gN > 0
            wideRow(dash, r, "RECENT EVENTS", color.new(color.blue, 45), size.tiny)
            r += 1
            shownEv = math.min(gN, maxEvents)
            for k = 0 to shownEv - 1
                g = array.get(gIdx, k)
                if r < TBL_ROWS
                    table.cell(dash, 0, r, ageStr(array.get(gOld, g)), text_color = color.new(color.white, 35), text_size = size.tiny, text_halign = text.align_left)
                    table.cell(dash, 1, r, evLine(array.get(gTxt, g), array.get(gCnt, g), array.get(gOld, g)), text_color = color.new(color.white, 5), text_size = size.tiny, text_halign = text.align_left)
                    table.merge_cells(dash, 1, r, 2, r)
                r += 1

        // --- WHAT CHANGED --- a header saying "nothing" is a row spent on
        // nothing, so the section is simply absent when nothing changed.
        if changed
            wideRow(dash, r, "WHAT CHANGED — since the last confirmed bar", color.new(color.blue, 55), size.tiny)
            r += 1
            wideRow(dash, r, changes, color.new(color.black, 55), size.tiny)
            r += 1

        // --- CURRENT ANOMALIES ---
        if anomCount > 0
            wideRow(dash, r, "CURRENT ANOMALIES: " + str.tostring(anomCount), color.new(color.orange, 30), size.tiny)
            r += 1
            idx = array.sort_indices(aExt, order.descending)
            shown = math.min(anomCount, maxAnom)
            for k = 0 to shown - 1
                pick = array.get(idx, k)
                if r < TBL_ROWS
                    table.cell(dash, 0, r, array.get(aName, pick), text_color = color.new(color.white, 10), text_size = size.tiny, text_halign = text.align_left)
                    table.merge_cells(dash, 0, r, 1, r)
                    table.cell(dash, 2, r, pRank(array.get(aPct, pick)) + "  " + sgn2(array.get(aZ, pick)) + "σ", text_color = color.white, bgcolor = color.new(color.orange, 35), text_size = size.tiny, text_halign = text.align_right)
                r += 1

        // --- MARKET MECHANICS ---
        wideRow(dash, r, "MARKET MECHANICS — description, not implication", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, "PRICE 24H", na(px24) ? "n/a" : pctS(px24), mechPx > 0 ? "UP" : mechPx < 0 ? "DOWN" : "FLAT")
        r += 1
        addRow(dash, r, "OI 24H", val3(pctS(oiChg24h), oiP24, oiZ24), oi24Lbl)
        r += 1
        wideRow(dash, r, "  " + mechLbl, color.new(color.gray, 45), size.tiny)
        r += 1
        if str.length(mechSent) > 0
            wideRow(dash, r, "  " + mechSent, color.new(color.black, 70), size.tiny)
            r += 1
        wideRow(dash, r, "  " + mechNote, color.new(color.black, 70), size.tiny)
        r += 1

        // --- TREND / VOLATILITY ---
        wideRow(dash, r, "TREND / VOLATILITY — persistent regime", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, "TREND", dailyOK ? sgn2(trendDist) + " ATR from 200D" : "no daily", trendLbl)
        r += 1
        addRow(dash, r, "VOLATILITY", "ATR " + pctS(atrPct) + "  " + pRank(volPct), volLbl)
        r += 1
        addRow(dash, r, "MOMENTUM 12W", na(dMom12w) ? "no daily" : pctS(dMom12w), na(dMom12w) ? "DATA UNAVAILABLE" : dMom12w > 0 ? "UP OVER 12 WEEKS" : dMom12w < 0 ? "DOWN OVER 12 WEEKS" : "FLAT")
        r += 1
        addRow(dash, r, "TREND (combined)", "200D " + (trSt > 0 ? "above" : trSt < 0 ? "below" : "near") + " + 12W " + (na(dMom12w) ? "n/a" : dMom12w > 0 ? "up" : "down"), kTrendWord)
        r += 1

        // --- DERIVATIVES ---
        wideRow(dash, r, "DERIVATIVES", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, "OI 24H", oiLooksNotional ? "REJECTED [" + (na(oiCur) ? "?" : oiCur) + "]" : oiOK ? val3(pctS(oiChg24h), oiP24, oiZ24) : "no OI", oi24Lbl)
        r += 1
        addRow(dash, r, "OI 4H *", oiOK ? val3(pctS(oiChg4h), oiP4, oiZ4) : "no OI", oi4Lbl)
        r += 1
        addRow(dash, r, "FUNDING", fundOK ? val3(pct4(fundRaw), fundP, fundZ) : (useFunding ? "check adapter" : "adapter off"), fundLbl)
        r += 1
        addRow(dash, r, "PREMIUM *", na(premium) ? "no spot/ref" : val3(pct4(premium), premP, premZ), premLbl)
        r += 1
        addRow(dash, r, "LONG LIQ *", liqLOK ? val3(big(extLiqL), liqLP, liqLZ) : (useLiqL ? "check adapter" : "adapter off"), liqLLbl)
        r += 1
        addRow(dash, r, "SHORT LIQ *", liqSOK ? val3(big(extLiqS), liqSP, liqSZ) : (useLiqS ? "check adapter" : "adapter off"), liqSLbl)
        r += 1
        addRow(dash, r, "LIQ BALANCE", liqBalOK ? val3(sgn2(liqBal), liqBP, liqBZ) : not liqOK ? "both sides needed" : "declare shared unit", liqBLbl)
        r += 1

        // --- PARTICIPATION ---
        wideRow(dash, r, "PARTICIPATION — volume vs the same UTC slot on prior days", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, "SPOT RVOL *", na(rvolSpot) ? "no volume" : val3(f2(rvolSpot) + "x", rvolSpotP, rvolSpotZ), rsLbl)
        r += 1
        addRow(dash, r, "PERP RVOL *", na(rvolPerp) ? "no volume" : val3(f2(rvolPerp) + "x", rvolPerpP, rvolPerpZ), rpLbl)
        r += 1
        addRow(dash, r, "RELATIVE", partOK ? val3(sgn2(partRaw), partP, partZ) : "no volume", partLbl)
        r += 1

        // --- FLOW ---
        wideRow(dash, r, "FLOW — ESTIMATED from lower-timeframe bar direction", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, "PERP DELTA", flowOK ? f2(perpDelta) : "no intrabar", flowOK ? (perpDelta > 0 ? "NET UP-BAR VOLUME" : "NET DOWN-BAR VOLUME") : "DATA UNAVAILABLE")
        r += 1
        addRow(dash, r, "SPOT DELTA", flowOK ? f2(spotDelta) : "no intrabar", flowOK ? (spotDelta > 0 ? "NET UP-BAR VOLUME" : "NET DOWN-BAR VOLUME") : "DATA UNAVAILABLE")
        r += 1

        // --- SLOW CONTEXT ---
        wideRow(dash, r, "SLOW CONTEXT", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, etfRowLbl, etfOK ? val3(big(etf5d), etfP, etfZ) : (useEtf ? "check adapter" : "adapter off"), etfLbl)
        r += 1
        addRow(dash, r, "SOPR", soprOK ? val3(f2(soprD), soprP, soprDev) : "no feed", soprLbl)
        r += 1

        // --- DATA HEALTH, split by what can actually be measured ---
        wideRow(dash, r, "DATA HEALTH — timestamp-verified (lag is measured)", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, "Reference", refSym, statWord(refStat))
        r += 1
        addRow(dash, r, "Spot", spotSym, statWord(spotStat))
        r += 1
        addRow(dash, r, "Open interest", oiLooksNotional ? "REJECTED — looks USD" : oiSym, oiLooksNotional ? "UNAVAILABLE" : statWord(oiStat))
        r += 1
        addRow(dash, r, "Daily 200MA", "1D on reference", statWordD(dailyStat))
        r += 1
        addRow(dash, r, "SOPR", soprSym, statWordD(soprStat))
        r += 1
        wideRow(dash, r, "DATA HEALTH — external adapters (update activity only, no upstream timestamp)", color.new(color.blue, 60), size.tiny)
        r += 1
        addRow(dash, r, "Funding", useFunding ? (fundUnit) : "off", adaptWord(fdStat))
        r += 1
        addRow(dash, r, "ETF flow", useEtf ? (etfNaGated ? "na-gated observations" : etfDailyMode ? "daily value, calendar sample" : "per-bar increment") : "off", adaptWord(etStat))
        r += 1
        addRow(dash, r, "Long liquidations", useLiqL ? "adapter" : "off", adaptWord(lLStat))
        r += 1
        addRow(dash, r, "Short liquidations", useLiqS ? "adapter" : "off", adaptWord(lSStat))
        r += 1
        addRow(dash, r, "Liq pairing", liqPaired ? "declared same unit" : "not declared", liqPaired ? "BALANCE ENABLED" : "BALANCE WITHHELD")
        r += 1

        // --- DEBUG --- the internals, and only here. A number in this block
        // means nothing to a reader who has not read the source, which is
        // exactly why it does not appear in Compact or Detailed.
        if modeDebug
            wideRow(dash, r, "DEBUG — internals; not a reading", color.new(color.purple, 40), size.tiny)
            r += 1
            addRow(dash, r, "Valid samples", "oi4 " + str.tostring(oiN4) + " · oi24 " + str.tostring(oiN24) + " · prem " + str.tostring(premN) + " · part " + str.tostring(partN), "n IN WINDOW")
            r += 1
            addRow(dash, r, "Valid samples", "spotRV " + str.tostring(rvSpN) + " · perpRV " + str.tostring(rvPpN) + " · sopr " + str.tostring(soprN) + " · min " + str.tostring(minSamp), "n IN WINDOW")
            r += 1
            addRow(dash, r, "Feed status codes", "ref " + str.tostring(refStat) + " · spot " + str.tostring(spotStat) + " · oi " + str.tostring(oiStat) + " · daily " + str.tostring(dailyStat) + " · sopr " + str.tostring(soprStat), "0..4")
            r += 1
            addRow(dash, r, "Adapter status codes", "fd " + str.tostring(fdStat) + " · etf " + str.tostring(etStat) + " · liqL " + str.tostring(lLStat) + " · liqS " + str.tostring(lSStat), "0..4")
            r += 1
            addRow(dash, r, "Intensity levels", "oi24 " + str.tostring(oi24Lvl) + " · oi4 " + str.tostring(oi4Lvl) + " · prem " + str.tostring(pmLvl) + " · fund " + str.tostring(fdLvl) + " · etf " + str.tostring(etLvl) + " · part " + str.tostring(ptLvl), "0/1/2")
            r += 1
            addRow(dash, r, "Regime codes", "trSt " + str.tostring(trSt) + " · spSt " + str.tostring(spSt) + " · oi24St " + str.tostring(oi24St), "signed")
            r += 1
            addRow(dash, r, "Exact z", "oi24 " + sgn2(oiZ24) + " · smoothed " + sgn2(oiZ24s) + " · prem " + sgn2(premZ) + " · part " + sgn2(partZ), "σ, unrounded")
            r += 1
            addRow(dash, r, "Event buffer", "accepted " + str.tostring(array.get(evStat, 0)) + " · suppressed " + str.tostring(array.get(evStat, 1)) + " · held " + str.tostring(evCount) + " · display groups " + str.tostring(gN), "PROSPECTIVE LOG")
            r += 1
            addRow(dash, r, "Adapter held bars", "fd " + str.tostring(fdHeld) + " · etf " + str.tostring(etHeld) + " · etfObsAge " + str.tostring(etfObsAge) + " · liqL " + str.tostring(lLHeld) + " · liqS " + str.tostring(lSHeld), "UNCHANGED FOR")
            r += 1

        wideRow(dash, r, "EVIDENCE: DESCRIPTIVE   ACTION: CONTEXT ONLY", color.new(color.gray, 45), size.tiny)
        r += 1
        wideRow(dash, r, "Organises data. Predicts nothing. Direction from raw values, abnormality from percentiles. Flow is ESTIMATED.", color.new(color.black, 70), size.tiny)
        r += 1
    rowsUsed := r

plot(dailyOK ? dSma200 : na, "Daily 200MA (reference symbol)", color = color.new(color.orange, 30), linewidth = 2)

// CHART LABEL — OFF BY DEFAULT, AND ONE SHORT LINE WHEN ON.
//
// v3.2 pinned a paragraph to the last bar's high with style_label_left, which
// on a default top-right dashboard sat directly on top of the panel and stayed
// there for as long as the condition held. Every warning it carried now has a
// permanent home in the panel itself — SETUP REQUIRED and the DATA issue list
// in Compact, DATA HEALTH in Detailed — so the label is redundant by
// construction. It is kept as an opt-in for anyone who runs with the dashboard
// switched off, shortened to a single clause, and moved below the bar so that
// enabling it still does not cover the panel.
var label warn = na
if barstate.islast and warnLabel
    string msg = ""
    if oiLooksNotional
        msg := "⚠ OI feed looks USD-denominated — OI readings off"
    else if not oiOK
        msg := "⚠ Open interest unavailable or stale — OI readings off"
    else if fdStat == 1 or etStat == 1 or lLStat == 1 or lSStat == 1
        msg := "⚠ An adapter is enabled but not wired — see SETUP REQUIRED"
    else if soprStat == 2
        msg := "⚠ A timestamp-verified feed is stale — see DATA"
    else if fdStat == 2 or etStat == 2 or lLStat == 2 or lSStat == 2
        msg := "⚠ An adapter stopped updating — see DATA"
    else if liqLOK and liqSOK and not liqPaired
        msg := "⚠ Liquidation pairing not declared — balance withheld"
    label.delete(warn)
    if msg != ""
        warn := label.new(bar_index, low, msg, yloc = yloc.price, color = color.new(color.orange, 20), textcolor = color.white, style = label.style_label_up, size = size.tiny)

// ---- test hooks, hidden from the chart and the Data Window ----
// Pine allows at most 64 plot outputs, so the nine feed statuses, the eleven
// direction codes, the ten intensity levels and the seven booleans are packed
// into one number each. All four are exact in a float64: 5^9 = 1,953,125,
// 3^11 = 177,147 and 2^7 = 128.
// The boolean pack was added when the risk-budget outputs took the file to the
// 64-plot ceiling exactly. Bit order is fixed and decoded in tests.mjs:
//   1 tfOK  2 oiObs  4 flowOK  8 partOK  16 oiOK  32 oiLooksNotional  64 changed
boolPack = (tfOK ? 1 : 0) + (oiObs ? 2 : 0) + (flowOK ? 4 : 0) + (partOK ? 8 : 0) + (oiOK ? 16 : 0) + (oiLooksNotional ? 32 : 0) + (changed ? 64 : 0)
statPack = refStat + 5 * (spotStat + 5 * (oiStat + 5 * (dailyStat + 5 * (soprStat + 5 * (fdStat + 5 * (etStat + 5 * (lLStat + 5 * lSStat)))))))
dirPack  = (oi24Dir + 1) + 3 * ((oi4Dir + 1) + 3 * ((pmDir + 1) + 3 * ((fdDir + 1) + 3 * ((etDir + 1) + 3 * ((ptDir + 1) + 3 * ((rsDir + 1) + 3 * ((rpDir + 1) + 3 * ((lqBDir + 1) + 3 * ((mechPx + 1) + 3 * (mechOi + 1))))))))))
lvlPack  = oi24Lvl + 3 * (oi4Lvl + 3 * (pmLvl + 3 * (fdLvl + 3 * (etLvl + 3 * (ptLvl + 3 * (rsLvl + 3 * (rpLvl + 3 * (lqLLvl + 3 * lqSLvl))))))))
float maxExt = na
if anomCount > 0
    maxExt := array.max(aExt)

